* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Generated scientific datasets are intentionally versioned but should not
# dominate GitHub language statistics or produce noisy review diffs.
data/markdown_bundle/**/*.md linguist-generated=true
data/graph/chunk_extractions/*.json linguist-generated=true
data/graph/paper_graphs/*.json linguist-generated=true
data/structured/*.md linguist-generated=true
