  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "grain subdivision",
      "category": "deformation",
      "sample_id": "sample_2",
      "material_state": "as-cryo-rolled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 3,
          "section": "4. Discussion",
          "quote": "Cryo-rolling leads to a nanocrystalline lamellar structure due to the \ngrain subdivision process [11]. The mechanism involves the accumu -\nlation of dislocations, systematic increment in misorientation, and ulti -\nmate transformation of the LABs into HABs.",
          "table": null,
          "figure": null,
          "chunk_id": "f01aa47c85d429be:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "strain partitioning",
      "category": "deformation",
      "sample_id": "sample_2",
      "material_state": "as-cryo-rolled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "4. Discussion",
          "quote": "Therefore, strain is partitioned to a greater extent in the softer FCC during cryo-rolling.",
          "table": null,
          "figure": null,
          "chunk_id": "f01aa47c85d429be:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "back-stress strengthening",
      "category": "strain hardening",
      "sample_id": "sample_4",
      "material_state": "annealed at 900 °C for 1 h",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "4. Discussion",
          "quote": "The incompatibility favors \nstrain gradients to develop, accommodated by the emission and pile-up \nof dislocations at the domain interfaces/boundaries [13]. These phe -\nnomena lead to long-range back-stress resisting the yielding of the softer \nphase until the hard domains undergo yielding. Consequently, the \noverall yield strength and back-stress-induced strain-hardening are \nenhanced.",
          "table": null,
          "figure": null,
          "chunk_id": "f01aa47c85d429be:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
