      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "444",
          "section": "3.5 Mechanical Characterization",
          "quote": "There appear to be two main reasons for the refinement of the grains. The first one was during the beginning of the solidification, during which some of the particles acted as nucleation sites for the aluminum matrix. Secondly, during the solidification process, the particulates around the aluminum matrix caused a pinning effect on the matrix, restricting the grain growth.",
          "table": null,
          "figure": null,
          "chunk_id": "7b83812c6891cc28:part:030"
