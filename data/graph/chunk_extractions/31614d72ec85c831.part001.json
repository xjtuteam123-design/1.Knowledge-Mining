      "evidence": [
        {
          "page": "2",
          "section": "3.1 Alloy preparation",
          "quote": "The Fe-enriched HEA was prepared in an arc-melting furnace using a water-cooled copper mould in an argon atmosphere. Commercial metal powders (Fe, Ni, Cr and Mo) with 99.9 wt% purity were mixed according to the designed compositions and mechanically agitated for half an hour to ensure homogeneity. Then the blended powders were compacted into small cylinders of 14 mm in diameter and 20 mm long. To ensure the chemical homogeneity, these cylinders was remelted four times with processing parameters of 250 A current and 28.5 V voltage.",
          "table": null,
          "figure": null,
          "chunk_id": "31614d72ec85c831:part:001"
        }
      ]
    },
