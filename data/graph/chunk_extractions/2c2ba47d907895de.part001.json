  "alloy_systems": [
    {
      "id": "alloy_system_1",
      "name": "Ti-Al-Mo-Zr-Si-W alloy",
      "material_category": "high-temperature titanium alloy",
      "evidence": [
        {
          "page": "1",
          "section": "ABSTRACT",
          "quote": "Additive manufactured high-temperature titanium alloys typically exhibit poor plasticity and crack sensitivity. In this work, a novel strategy incorporating high-melting-point, low-diffusivity tungsten (W) as a microstructural modifier was designed for Ti-6.5Al-3.5Mo-1.5Zr-0.3Si alloy, with subsequent processing by laser powder bed fusion.",
          "table": null,
          "figure": null,
          "chunk_id": "2c2ba47d907895de:part:001"
        }
      ]
    }
  ],
