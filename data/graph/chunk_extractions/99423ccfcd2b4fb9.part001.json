  "alloy_systems": [
    {
      "id": "alloy_system_1",
      "name": "refractory high-entropy metal-ceramic composite (HEMCC)",
      "material_category": "metal-ceramic composite",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "A new concept of refractory high-entropy metal-ceramic composites (HEMCC) has been proposed that combines the outstanding physical properties of both high-entropy alloy (HEA) and high-entropy ceramic (HEC). As the first HEMCC system, to the best of our knowledge, TiTaNbZr-(TiTaNbZr)C, has been developed by a powder metallurgy process.",
          "table": null,
          "figure": null,
          "chunk_id": "99423ccfcd2b4fb9:part:001"
        }
      ]
    },
    {
