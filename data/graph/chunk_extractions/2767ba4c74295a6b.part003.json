      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 8,
          "section": "3.1.2. Second particle/precipitation phase",
          "quote": "The role of second particles or intermetallic precipitates in maintaining high-temperature thermal stability is crucial, as they activate the pinning mechanism that hinders grain boundary movement.",
          "table": null,
          "figure": null,
          "chunk_id": "2767ba4c74295a6b:part:003"
        }
      ]
    },
    {
      "id": "mechanism_5",
      "name": "Friedel cutting",
      "category": "particle-dislocation interaction",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 8,
          "section": "3.1.2. Second particle/precipitation phase",
          "quote": "Second particles in microstructure enhance thermal stability and strength through either Friedel cutting or Orowan bypassing mechanisms, based on their size. Small particles trigger cutting, causing dislocation shearing, while larger ones lead to the bypassing mechanism by requiring more energy.",
          "table": null,
          "figure": null,
          "chunk_id": "2767ba4c74295a6b:part:003"
        }
      ]
