      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 10,
          "section": null,
          "quote": "some secondary phases located on grain boundaries such as W carbide can act as nuclei of cavity formation and have incidental effects on grain boundary weakening. Therefore, these causes of grain boundary weakening are thought to have acted in combination so that the strength of the K4 was degraded at high temperatures and intergranular fractures occurred in compression specimens under all temperature conditions.",
          "table": null,
          "figure": null,
          "chunk_id": "e778098e398569be:part:003"
        }
      ]
    },
    {
      "id": "mechanism_4",
