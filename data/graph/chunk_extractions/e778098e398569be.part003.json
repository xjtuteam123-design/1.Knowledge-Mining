      "material_state": "tested",
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 9,
          "section": null,
          "quote": "Therefore, the unique fracture surface of the K4 is thought to be a type of intergranular fracture, and the modes of the intergranular fractures are judged to vary according to temperature.",
          "table": null,
          "figure": null,
          "chunk_id": "e778098e398569be:part:003"
        }
      ]
    },
    {
      "id": "mechanism_5",
