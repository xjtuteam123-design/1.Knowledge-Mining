  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 7,
          "section": "Conclusions",
          "quote": "The ambient and high temperature strengthening effect can be attributed to three possible factors: the solid solution strengthening of Al, HDI hardening of finer eutectic lamellar structure, and precipitation strengthening of high-density thermally stable ordered L12 and disordered BCC nano-precipitates.",
          "table": null,
          "figure": null,
          "chunk_id": "b8986c3b18a8a54c:part:002"
