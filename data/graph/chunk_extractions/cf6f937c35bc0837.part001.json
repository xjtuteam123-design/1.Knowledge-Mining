    {
      "id": "phase_2",
      "type": "Phase",
      "name": "C14 Laves",
      "sample_id": "sample_1",
      "material_state": "as-cast",
      "attributes": {
        "phase_fraction": "46%",
        "size": "large lamellae exceeding hundreds of micrometres in length; small lamellae <= 10 um",
        "morphology": "lamellae, bimodal distribution",
        "location": "embedded into B2 matrix",
        "composition": "Al 35.1, Cr 20.1, Ti 37.8, Fe 6.9 (at%)",
        "identification_status": "experimental"
      },
      "evidence": [
        {
          "page": 3,
          "section": "3.1. Initial structure",
          "quote": "The Al35Cr18Ti42Fe5 alloy had a Widmanstätten structure composed of the light-grey C14 Laves phase lamellae, slightly enriched in Al, Cr, and Fe, embedded into the dark-grey B2 matrix, enriched in Ti",
