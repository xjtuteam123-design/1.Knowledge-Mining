        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "lattice misfit",
      "category": "microstructural mechanism",
      "sample_id": null,
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3.2 Room-Temperature Mechanical Properties",
          "quote": "The increase in Co content and a decrease in Mo content, result in a variation of the lattice misfit between BCC and B2 phases, which initially decreases and then increases. This reduction in lattice misfit contributes to the alleviation of lattice strain and strain energy, thereby enhancing the structural stability of the alloy and improving the strength and plasticity of the alloy",
          "table": null,
          "figure": null,
          "chunk_id": "194cd6e0d68c0858:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "grain refinement",
      "category": "strengthening mechanism",
      "sample_id": null,
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3.2 Room-Temperature Mechanical Properties",
          "quote": "In general, the refinement of grain size can enhance the strength and ductility of alloys. This is due to an inverse relationship between interlayer spacing size and volume fraction of grain boundaries, indicating that smaller grains increase interfacial anti-slip ability near these boundaries",
          "table": null,
          "figure": null,
          "chunk_id": "194cd6e0d68c0858:part:001"
        }
      ]
    }
