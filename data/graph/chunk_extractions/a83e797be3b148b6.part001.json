    {
      "id": "defect_2",
      "type": "Defect",
      "name": "Kirkendall void",
      "sample_id": "sample_2",
      "material_state": "homogenized",
      "attributes": {
        "size": null,
        "morphology": null,
        "location": "interdendritic regions",
        "composition": null,
        "identification_status": "author_hypothesis"
      },
      "evidence": [
        {
          "page": "5",
          "section": "Results/Discussion",
          "quote": "In the homogenized sample, an increase in the pore density could also be driven by the Kirkendall effect. During interdiffusion, the light species V in the interdendrite region may diffuse more rapidly than the heavy species W in the dendrite. The difference in diffusion rates could lead to a net flux of vacancies toward the interdendrite, resulting in the nucleation and growth of Kirkendall voids at the interface.",
          "table": null,
          "figure": "1",
          "chunk_id": "a83e797be3b148b6:part:001"
        }
      ]
