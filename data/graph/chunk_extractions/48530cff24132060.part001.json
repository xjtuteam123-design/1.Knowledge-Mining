    {
      "id": "mechanism_3",
      "name": "dislocation pile-up at α/β interface",
      "category": "work hardening",
      "sample_id": "sample_2",
      "material_state": "lamellar α phase + β matrix",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3.2.1 Initial state of samples",
          "quote": "This is mainly because the lamellar α phase hinders the dislocation movement in the ﬁrst stage. Many dislocation accumulation and entanglement are formed at the α/β interface, resulting in peak stress significantly higher than that of the equiaxed α phase [43].",
          "table": null,
          "figure": null,
          "chunk_id": "48530cff24132060:part:001"
        }
      ]
    },
