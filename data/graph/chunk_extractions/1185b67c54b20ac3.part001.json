      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "FeCrAl-based ODS alloys are promising for Generation IV nuclear reactor components since they present remarkable properties, such as high mechanical strength and good irradiation resistance. However, there is still relatively little information on the impact of minor alloying elements, e.g., Ti or V, and manufacturing conditions on the properties of these alloys.",
          "table": null,
          "figure": null,
          "chunk_id": "1185b67c54b20ac3:part:001"
