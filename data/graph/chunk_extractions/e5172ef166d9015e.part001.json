    {
      "id": "process_1",
      "sample_id": "sample_1",
      "sequence": 1,
      "method": "laser melting deposition (LMD)",
      "parameters": {
        "temperature_c": null,
        "time": null,
        "pressure": null,
        "atmosphere": "argon",
        "cooling_method": null,
        "deformation": null,
        "strain_rate": null,
        "laser_power_w": 800,
