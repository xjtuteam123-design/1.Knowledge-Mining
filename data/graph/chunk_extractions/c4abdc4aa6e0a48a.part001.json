      "id": "alloy_system_1",
      "name": "W-Re alloy",
      "material_category": "refractory alloy",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "Pure tungsten produced by laser-based additive manufacturing suffers from cracking due to its brittle nature. The cracking could be improved but not eliminated through optimisation of the build process parameters and scan strategies. Alloying to improve ductility and reduce oxygen contamination at grain boundaries proved more successful.",
          "table": null,
          "figure": null,
          "chunk_id": "c4abdc4aa6e0a48a:part:001"
        }
      ]
    },
