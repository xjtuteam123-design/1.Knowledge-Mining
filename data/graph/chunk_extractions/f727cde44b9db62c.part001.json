          "figure": null,
          "chunk_id": "f727cde44b9db62c:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "interfacial disordering",
      "category": "ductilization",
      "sample_id": "sample_1",
      "material_state": "as-prepared",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "main text",
          "quote": "We discovered that nanoscale disordered interfaces can effectively overcome these problems. Interfacial disordering is driven by multielement cosegregation that creates a distinctive nanolayer between adjacent micrometer-scale superlattice grains.",
          "table": null,
          "figure": null,
          "chunk_id": "f727cde44b9db62c:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "dislocation mobility enhancement",
      "category": "deformation",
      "sample_id": "sample_1",
      "material_state": "as-prepared",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "main text",
          "quote": "This nanolayer acts as a sustainable ductilizing source, which prevents brittle intergranular fractures by enhancing dislocation mobilities.",
          "table": null,
          "figure": null,
          "chunk_id": "f727cde44b9db62c:part:001"
        }
      ]
    }
