    {
      "id": "alloy_system_1",
      "name": "Al-Co-Cr-Fe-Ni-Ti high entropy alloy",
      "material_category": "high entropy alloy",
      "evidence": [
        {
          "page": "1",
          "section": "Abstract",
          "quote": "An overview of the microstructural and mechanical properties of Al-Co-Cr-Fe-Ni-Ti high entropy alloys (HEAs) at high temperatures is presented.",
          "table": null,
          "figure": null,
          "chunk_id": "43e4c38711265cad:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_2",
      "name": "refractory high entropy alloy",
      "material_category": "refractory high entropy alloy",
      "evidence": [
        {
          "page": "2",
          "section": "1.4. Refractory high entropy alloys (RHEAs)",
          "quote": "RHEAs have the highest melting point compared to other HEAs [116 – 118] . However, the development of RHEAs has not yet reached its potential against high-temperature oxidation resistance and the balance between high-temperature strength and room-temperature ductility [119 – 123] .",
          "table": null,
          "figure": null,
          "chunk_id": "43e4c38711265cad:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_3",
      "name": "Ni-based superalloy",
      "material_category": "superalloy",
      "evidence": [
        {
          "page": "1",
          "section": "1.1. Traditional alloys",
          "quote": "The most commonly used materials for gas turbines in the aerospace and energy industries are superalloys [11 – 19] , especially Ni-based superalloys.",
          "table": null,
          "figure": null,
          "chunk_id": "43e4c38711265cad:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_4",
      "name": "CoCrFeMnNi high entropy alloy",
      "material_category": "high entropy alloy",
      "evidence": [
        {
          "page": "2",
          "section": "1.4. Refractory high entropy alloys (RHEAs)",
          "quote": "CoCrFeMnNi is the most familiar HEA containing, 3d-TM. The single-phase solid solution of these HEAs is known to offer the best combination of strength and toughness at cryogenic temperatures [126,127] , but is handicapped by its poor mechanical properties at high temperatures [128 – 130] .",
          "table": null,
          "figure": null,
          "chunk_id": "43e4c38711265cad:part:001"
        }
      ]
    }
  ],
