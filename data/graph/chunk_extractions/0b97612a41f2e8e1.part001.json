    {
      "id": "mechanism_2",
      "name": "oxygen embrittlement",
      "category": "embrittlement",
      "sample_id": "sample_2",
      "material_state": "as-built",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": 6,
          "section": "4.2 Cracking",
          "quote": "Oxygen is a particular problem: oxygen reacts readily with tungsten at high temperatures, but has very low solubility in solid tungsten. This means that oxygen dissolved in the melt pool at high temperatures will tend to segregate to grain boundaries, where it can form various species of tungsten oxides. These oxides then reduce grain boundary strength, leaving intergranular fracture as the dominant failure mode.",
          "table": null,
          "figure": null,
          "chunk_id": "0b97612a41f2e8e1:part:001"
        }
      ]
    }
