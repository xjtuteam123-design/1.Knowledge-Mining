        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "liquid phase sintering",
      "category": "process",
      "sample_id": null,
      "material_state": "sintered",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 14,
          "section": null,
          "quote": "The improved densification in high Y2O3 added sintered alloys is attributed to refined crystallite size, enhanced surface energy and grain boundary energy of W which facilitates faster diffusion (mass transfer along the neck region of W/solute atoms) and chemical activation for liquid phase sintering (MoNi, Ni3Ti phase formation) with respect to pore filling.",
          "table": null,
          "figure": null,
          "chunk_id": "d9533f3f4d642935:part:002"
        }
      ]
    },
