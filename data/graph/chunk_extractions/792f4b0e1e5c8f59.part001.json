        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "increased nucleation rate by Sr",
      "category": "solidification",
      "sample_id": "sample_8",
      "material_state": "directionally solidified",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": 6,
          "section": "3.4 Possible mechanisms of Sr addition on microstructure of Nb–Si-based alloys",
          "quote": "Surface active element Sr can improve the wettability and reduce the liquid surface tension since Sr atoms absorbed on the growing crystals change the solid/liquid interfacial energy, which would enhance the nucleation rate",
