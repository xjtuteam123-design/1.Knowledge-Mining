      "evidence": [
        {
          "page": 2,
          "section": "1. Introduction",
          "quote": "solid-solution microalloying of Mo—via additions of W, Re, Nb, Ti or Zr—induces lattice distortions that impede dislocation motion and thereby markedly enhance both strength and high-temperature creep resistance relative to pure Mo",
          "table": null,
          "figure": null,
          "chunk_id": "af2eac42927c5361:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "precipitation strengthening",
      "category": null,
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 9,
          "section": "3.2.2. Evaluation Results for Binary Mo Alloys and Element Selection",
          "quote": "Among the phases considered, Mo2B, Mo2C, and Mo3Si have moderately favorable volume fractions and high driving forces, making them representative precipitates for precipitation-strengthened binary Mo alloys",
          "table": null,
          "figure": null,
          "chunk_id": "af2eac42927c5361:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "rhenium effect",
      "category": null,
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 16,
          "section": "4.2. Ductility",
          "quote": "Re causes the largest reduction in “average bond stiffness” among the elements studied, and it also causes a relatively small average atomic displacement at the same concentration (second only to W). Compared to many other elements, Re exhibits a uniquely favorable trend for ductility. Thus, from the perspective of average atomic displacement and “average bond stiffness,” our results provide confirmation of the unique “Re effect.”",
          "table": null,
          "figure": null,
          "chunk_id": "af2eac42927c5361:part:001"
        }
      ]
    }
