      "evidence": [
        {
          "page": 2,
          "section": "2. Experimental procedures",
          "quote": "The CrFeCoNiAl0.7 (at. %) HEA castings were prepared by electromagnetic induction melting in a high-purity argon atmosphere. The pure metals and master alloys of Ni-Al and Fe-Al (purity > 99.9 wt. %) were used as starting materials to minimize the evaporation of Al. Melting was performed in a MgO crucible using a vacuum induction furnace operating at 5−30 kW. Prior to melting, the furnace was ﬁrst evacuated to ∼5 × 10−2 Pa and then backﬁlled with pure Ar and evacuated twice to dilute the residual air inside the chamber, ﬁnally backﬁlled a pressure of ∼5 × 104 Pa.",
          "table": null,
          "figure": null,
          "chunk_id": "4dfac0e17edc7bfd:part:001"
        }
      ]
    },
