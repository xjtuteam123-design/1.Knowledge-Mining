      "evidence": [
        {
          "page": "2",
          "section": "2. Materials and methods",
          "quote": "The rectangular bars (10×10×25 mm3) were cut from the ingots and subjected to a homogenization and a solid-solution treatment with the following regime: annealing at a temperature of 1473 K for 2 h, multipass cold rolling up to 80% reduction, and annealing at 1473 K for 2 h with a subsequent water-quenching.",
          "table": null,
          "figure": null,
          "chunk_id": "f1f70f90e972f101:part:001"
