        "other": {
          "crucible": "periclase",
          "degassing": "vacuum of inactive components (Fe, Ni, Co)",
          "sequence": "Fe, Ni, Co melted/degraded; Cr, Mn, MnN added sequentially via dispenser"
        }
      },
      "input_state": "elements",
      "output_state": "as-cast",
      "evidence": [
        {
          "page": "2",
          "section": "2. Materials and methods",
          "quote": "Four ingots of the multi-principal element alloys (MPEAs) were obtained by vacuum induction melting in pure Ar atmosphere using a periclase crucible. First, melting and degassing in a vacuum of inactive components (iron, nickel, cobalt) were performed. Then, chromium, manganese and MnN (for nitrogen introducing) were sequentially added into the melt through a dispenser. The molten metal was casted in an argon atmosphere into a flat mold.",
          "table": null,
          "figure": null,
          "chunk_id": "f1f70f90e972f101:part:001"
        }
      ]
    },
