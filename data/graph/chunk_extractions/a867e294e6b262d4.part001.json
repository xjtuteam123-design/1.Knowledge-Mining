          "remelting_cycles": "4-6",
          "ingot_thickness": "6.5 mm",
          "ingot_diameter": "20 mm"
        }
      },
      "input_state": "pure elements",
      "output_state": "as-cast ingot",
      "evidence": [
        {
          "page": 2,
          "section": "2 Experimental procedures",
          "quote": "The mixture with the desired composition was melted and alloyed in a high vacuum arc-melting furnace. The furnace was evacuated to 5 × 10^-3 Pa during smelting process to minimize evaporation and oxidation losses. To enhance the homogeneity, the ingot was flipped over and re-melted 4 – 6 times. The last melting step was completed by furnace cooling while the surface of melt looked homogeneous. And then a button ingot with a thickness of about 6.5 mm and a diameter of 20 mm was fabricated successfully.",
          "table": null,
          "figure": null,
          "chunk_id": "a867e294e6b262d4:part:001"
        }
      ]
    },
    {
      "id": "process_2",
      "sample_id": "sample_2",
      "sequence": 2,
      "method": "hot rolling",
      "parameters": {
        "temperature_c": 1000,
        "time": null,
        "pressure": null,
        "atmosphere": null,
        "cooling_method": null,
        "deformation": "single-pass reduction 5-10%, final thickness 1.5 mm",
        "strain_rate": null,
        "laser_power_w": null,
        "scan_speed": null,
        "layer_thickness": null,
        "other": {}
      },
      "input_state": "as-cast ingot",
      "output_state": "hot-rolled sheet",
      "evidence": [
        {
          "page": 2,
          "section": "2 Experimental procedures",
          "quote": "In order to obtain high-quality alloy sheets, the hot rolling process at 1000 °C was done on the ingot. The single-pass reduction was set as 5 – 10 %, and the final thickness was reduced to 1.5 mm.",
          "table": null,
          "figure": null,
          "chunk_id": "a867e294e6b262d4:part:001"
        }
      ]
