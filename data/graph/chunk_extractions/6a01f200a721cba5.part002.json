  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "anomalous increase of fracture toughness at high temperature",
      "category": "temperature-dependent fracture behavior",
      "sample_id": "sample_1",
      "material_state": "forged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 6,
          "section": "4. Conclusions",
          "quote": "There was such a causal relationship that led to the anomalous increase of fracture toughness at high temperature. It was “higher dislocation density in the microstructure” → “NSR2·δb2 > NSR1·δb1” (NSR1 ≈ 1) → “δy2bn|x=0 > δy1bn|x=0” → “F2 > F1” → KIC-high temperature > KIC-room temperature",
          "table": null,
          "figure": null,
          "chunk_id": "6a01f200a721cba5:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "dislocation slip on main slip surfaces",
      "category": "deformation mechanism",
      "sample_id": "sample_1",
      "material_state": "forged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 6,
          "section": "4. Conclusions",
          "quote": "The forging-induced texture, such as B2 < 100 > //RD and γ-TiAl < 011]//RD promoted the dislocations slip on the main slip surfaces during the high temperature fracture toughness test, contributing to the final high dislocation density.",
          "table": null,
          "figure": null,
          "chunk_id": "6a01f200a721cba5:part:002"
        }
      ]
    },
