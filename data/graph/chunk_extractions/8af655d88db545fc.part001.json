  "process_steps": [
    {
      "id": "process_1",
      "sample_id": "sample_1",
      "sequence": 1,
      "method": "solution treatment",
      "parameters": {
        "temperature_c": 850,
        "time": "30 min",
        "pressure": null,
        "atmosphere": "vacuum",
        "cooling_method": "water quenching",
        "deformation": null,
        "strain_rate": null,
        "laser_power_w": null,
        "scan_speed": null,
        "layer_thickness": null,
        "other": {}
      },
      "input_state": "hot-forged bar",
      "output_state": "solution-treated",
      "evidence": [
        {
          "page": 2,
          "section": "Experimental",
          "quote": "The hot-forged bar was cut into sheets with a thickness of 2.2 mm along the axial direction. To generate different initial grain sizes, the sheets were solution-treated at 850 and 780 /C176 C for 30 min in a tubular vacuum heat-treatment furnace with a protective argon atmosphere, respectively, followed by water quenching.",
          "table": null,
          "figure": null,
          "chunk_id": "8af655d88db545fc:part:001"
        }
      ]
    },
    {
      "id": "process_2",
      "sample_id": "sample_1",
      "sequence": 2,
      "method": "hot rolling",
      "parameters": {
        "temperature_c": 600,
        "time": null,
        "pressure": null,
        "atmosphere": "air",
        "cooling_method": "asbestos, then cooled to room temperature",
        "deformation": "reduction 10.3%",
        "strain_rate": null,
        "laser_power_w": null,
        "scan_speed": null,
        "layer_thickness": null,
        "other": {}
      },
      "input_state": "solution-treated",
      "output_state": "hot-rolled",
      "evidence": [
        {
          "page": 2,
          "section": "Experimental",
          "quote": "The solution-treated sheets were respectively preheated at 600, 650, 700, 750 and 800 /C176 C for 30 min in an air furnace, and then immediately rolled in one pass on a laboratory rolling mill with rolls of 230 mm in diameter at a rate of 0.24 m/s. The rolling reductions were in the range of 10.3-20.9%. Immediately after hot rolling, the samples were placed in the asbestos and then cooled to room temperature.",
          "table": null,
          "figure": null,
          "chunk_id": "8af655d88db545fc:part:001"
        }
      ]
    },
