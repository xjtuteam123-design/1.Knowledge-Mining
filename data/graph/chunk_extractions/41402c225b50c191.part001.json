  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dynamic recovery (DRV)",
      "category": "deformation mechanism",
      "sample_id": "sample_1",
      "material_state": "as-deposited, quasi-static compression at 300 °C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": "4.1 Quasi-static compression properties",
          "quote": "At 300 °C, the continuous work hardening behavior suggests that dynamic recovery (DRV) is the dominant process.",
          "table": null,
          "figure": "Fig. 8",
          "chunk_id": "41402c225b50c191:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "dynamic recrystallization (DRX)",
      "category": "deformation mechanism",
      "sample_id": "sample_1",
      "material_state": "as-deposited, quasi-static compression at 500-800 °C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": "4.1 Quasi-static compression properties",
          "quote": "the pronounced peak stress followed by continuous flow softening at 500 °C, 600 °C, and particularly 800 °C is characteristic of dynamic recrystallization (DRX).",
          "table": null,
          "figure": "Fig. 8",
          "chunk_id": "41402c225b50c191:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "Portevin-Le Chatelier (PLC) effect",
      "category": "deformation mechanism",
      "sample_id": "sample_1",
      "material_state": "as-deposited, dynamic compression at 25 °C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": "4.2 Dynamic compression properties",
          "quote": "During dynamic compression, the cyclic process of “pinning to stress concentration to unpinning to stress drop to re-pinning” occurs repeatedly, manifesting as the observed serrated fluctuations on the macroscopic stress-strain curve a phenomenon known as the Portevin-Le Chatelier (PLC) effect.",
          "table": null,
          "figure": "Fig. 9",
          "chunk_id": "41402c225b50c191:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "precipitation strengthening",
      "category": "strengthening mechanism",
      "sample_id": "sample_1",
      "material_state": "as-deposited, dynamic compression",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": "4.2 Dynamic compression properties",
          "quote": "the high-entropy alloy contains precipitates, such as the BCC_B2 phases shown in Fig. 6 (a), and these precipitates enhance strain hardening through precipitation strengthening.",
