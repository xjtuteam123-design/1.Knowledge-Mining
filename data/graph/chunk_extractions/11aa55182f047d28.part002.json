  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "over-aging",
      "category": "microstructural degradation",
      "sample_id": "sample_9",
      "material_state": "T6",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": "10",
          "section": "Fig. 14 discussion",
          "quote": "For aluminum alloys, this deviation could be attributed partially to over-aging effect at elevated temperatures.",
