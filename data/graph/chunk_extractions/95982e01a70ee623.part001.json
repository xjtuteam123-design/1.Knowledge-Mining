  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid-solution hardening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 2,
          "section": "2. Binary Fe–Al alloys",
          "quote": "The linear increase of the yield stress with increasing Al content up to about 20 at.% Al in the temperature range between room temperature and 500 8C has been attributed to solid-solution hardening of the disordered a-(Fe,Al) (A2) according to Suzuki’s theory for solid-solution hardening of b.c.c. alloys [7,17,18,22,23].",
          "table": null,
          "figure": null,
          "chunk_id": "95982e01a70ee623:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "yield stress anomaly",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 3,
          "section": "2. Binary Fe–Al alloys",
          "quote": "The increase of the yield stress with rising temperature between 100 and 500 8C at Al contents ranging from 26 to 31 at.% (Fig. 2) is caused by the yield stress anomaly which has its maximum at slightly higher temperatures than 500 8C.",
          "table": null,
          "figure": "Fig. 2",
