      "id": "mechanism_1",
      "name": "low diffusion rate of Fe, Mn and Ni",
      "category": "diffusion",
      "sample_id": "sample_3",
      "material_state": "annealed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 7,
          "section": "4.1 Precipitation behavior and high temperature stability",
          "quote": "According to Eq. (2), at 275 °C, the diffusion coefficients of Fe, Mn and Ni are 1.46 × 10-21 m2/s, 9.45 × 10-23 m2/s and 6.81 × 10-18 m2/s, respectively. Much lower than those of Si, Zn, Mg, which are 8.57 × 10-17 m2/s, 1.03 × 10-16 m2/s and 4.90 × 10-17 m2/s.",
          "table": null,
          "figure": null,
          "chunk_id": "e660e3e6a79ffe2a:part:001"
        },
        {
          "page": 7,
          "section": "4.1 Precipitation behavior and high temperature stability",
          "quote": "Lower diffusion rate means better thermal stability. As can be seen from Figs. 7 (e, f), the microstructure of the annealed alloy hardly changes compared with the as-built state and the mesh eutectic Si remains continuous, which is rarely detected in conventional SLM Al–Si alloys.",
          "table": null,
          "figure": "Figs. 7",
          "chunk_id": "e660e3e6a79ffe2a:part:001"
        }
      ]
