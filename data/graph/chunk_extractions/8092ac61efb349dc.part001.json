  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dislocation reaction",
      "category": "dislocation dynamics",
      "sample_id": "sample_1",
      "material_state": "as-relaxed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3.1. Results of the Cubic-Type Model",
          "quote": "As the dislocation slides outward, the No. 5 dislocation continues to elongate. When it reaches 24.86 ˙A, the dislocations of Nos. 1, 2, 3 and 4 no longer continue to slide. At this time, the No. 5 dislocation dissociates and forms some small circle-shaped dislocations at the nodes of the dislocation networks",
          "table": null,
          "figure": "Fig. 3",
          "chunk_id": "8092ac61efb349dc:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "dislocation dissociation",
      "category": "dislocation dynamics",
      "sample_id": "sample_1",
      "material_state": "as-relaxed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3.1. Results of the Cubic-Type Model",
          "quote": "At this time, the No. 5 dislocation dissociates and forms some small circle-shaped dislocations at the nodes of the dislocation networks (the green circles in Fig. 3), and this dissociation reaction process can minimize the local energy of the crystal caused by the dislocation motion, thereby reducing the system’s energy.",
          "table": null,
          "figure": "Fig. 3",
          "chunk_id": "8092ac61efb349dc:part:001"
        }
      ]
    }
