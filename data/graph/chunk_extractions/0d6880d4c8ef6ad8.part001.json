      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "Analysis of the microstructure and local crystallographic texture showed that the melt pool formed under the laser beam favoured solidiﬁcation in a preferred orientation by an epitaxial growth mechanism.",
