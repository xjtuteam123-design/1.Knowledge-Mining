          "figure": null,
          "chunk_id": "0d6880d4c8ef6ad8:part:001"
        },
        {
          "page": 7,
          "section": "3.4. Local crystallographic texture (EBSD)",
          "quote": "These grains grow competitively in the same way as columnar grains in conventional casting, the fastest growing crystals out competing their neighbours.",
          "table": null,
          "figure": null,
          "chunk_id": "0d6880d4c8ef6ad8:part:001"
        }
      ]
    },
