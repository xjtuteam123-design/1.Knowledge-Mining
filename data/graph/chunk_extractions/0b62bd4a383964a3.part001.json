  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "back stress strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "heterogeneous structure (homogenized, cold rolled, recrystallized)",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 2,
          "section": "Introduction",
          "quote": "Additionally, the observation of obvious hys- teresis loops in the low-temperature and room-temperature cyclic loading–unloading curves provides robust evidence of the presence of back stress strengthening.",
          "table": null,
          "figure": null,
          "chunk_id": "0b62bd4a383964a3:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "TWIP effect",
      "category": "deformation mechanism",
      "sample_id": "sample_1",
      "material_state": "heterogeneous structure (homogenized, cold rolled, recrystallized)",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "abstract",
          "quote": "Furthermore, phase ﬁeld simulation indicated that, besides the TWIP effect caused by the lower stack- ing fault energy, the subsequent deformation mechanisms, including the breakage of the wider twins into nanotwins to relieve the stress concentration, and the non-turning transfer of intracrystalline dis- locations by the nanotwin boundaries, are important reasons for the high strength and high ductility of the alloy at 77 K.",
          "table": null,
          "figure": null,
          "chunk_id": "0b62bd4a383964a3:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "hetero-deformation-induced hardening",
      "category": "strain hardening",
      "sample_id": "sample_1",
      "material_state": "heterogeneous structure (homogenized, cold rolled, recrystallized)",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "abstract",
          "quote": "Conversely, at ambient temperatures, deformation is governed by hetero-deformation- induced hardening, driven primarily by the accumulation of geometrically necessary dislocations (GNDs).",
          "table": null,
          "figure": null,
          "chunk_id": "0b62bd4a383964a3:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "Orowan looping",
      "category": "precipitation strengthening",
      "sample_id": "sample_1",
      "material_state": "heterogeneous structure (homogenized, cold rolled, recrystallized)",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "abstract",
          "quote": "At elevated temperatures (873–1073 K), dynamic interactions between precipitates and dislocations domi- nate, involving mechanisms such as the Portevin-Le Chatelier effect and precipitate bypass (e.g., Orowan looping), with stacking faults further contributing to strengthening.",
          "table": null,
          "figure": null,
          "chunk_id": "0b62bd4a383964a3:part:001"
        }
      ]
    },
