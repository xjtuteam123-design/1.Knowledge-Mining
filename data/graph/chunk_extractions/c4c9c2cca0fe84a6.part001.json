      "evidence": [
        {
          "page": 1,
          "section": "abstract",
          "quote": "The mechanical anisotropy reflected by the loss of the transverse strengths exists throughout the range of testing temperatures up to 1000 /C176C. The microstructural analysis revealed that the intrinsic Bauschinger effect, the loss of transverse yield strength, is caused by mechanical fibering in Alloy 617, which is originally induced during hot rolling processing.",
          "table": null,
          "figure": null,
          "chunk_id": "c4c9c2cca0fe84a6:part:001"
        }
      ]
    },
