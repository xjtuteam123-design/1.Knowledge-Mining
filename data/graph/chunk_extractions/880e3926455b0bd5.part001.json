    {
      "id": "mechanism_3",
      "name": "dislocation pinning by heavy-element clusters",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "heat-treated and crept",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3.4 Formation mechanism",
          "quote": "clusters enriched in heavy elements, including Cr, Co and Re, exert a pinning force that stops the movement of dislocations, retards the displacement of the c/c0 interface during creep, and thus improves the creep resistance of superalloys.",
          "table": null,
          "figure": "Fig. 4",
          "chunk_id": "880e3926455b0bd5:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
