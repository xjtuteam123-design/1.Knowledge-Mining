        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "back stress strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 9,
          "section": null,
          "quote": "As dislo - cations transition from the relatively softer FCC matrix to the harder L12 γ’ precipitate, they accumulate at the interface, giving rise to substantial back stress. This back stress, in turn, counteracts applied shear stresses, resulting in a significantly elevated apparent strength for FCC matrix.",
