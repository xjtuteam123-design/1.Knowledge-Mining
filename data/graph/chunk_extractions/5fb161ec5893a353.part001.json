      "evidence": [
        {
          "page": 3,
          "section": "Abstract",
          "quote": "Oxide dispersion strengthened (ODS) molybdenum alloys being developed for high temperature applications possess excellent high temperature strength and creep resistance.",
          "table": null,
          "figure": null,
          "chunk_id": "5fb161ec5893a353:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_2",
      "name": "Mo-Re alloy",
      "material_category": "molybdenum-rhenium alloy",
      "evidence": [
        {
          "page": 3,
          "section": "Abstract",
          "quote": "Dilute rhenium additions (7 and 14 vvt.Y!o)to ODS molybdenum were evaluated to determine their effect on low temperature ductility. The addition of 7 vvt.940rhenium to the ODS molybdenum did not significantly enhance the mechanical properties. However, the addition of 14 wt.% rhenium to the ODS molybdenum resulted in a DBTT well below room temperature in both the stress-relieved and recrystallized condition.",
          "table": null,
          "figure": null,
          "chunk_id": "5fb161ec5893a353:part:001"
        }
      ]
    }
  ],
