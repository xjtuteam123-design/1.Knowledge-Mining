      "name": "dispersion strengthening",
      "sample_id": "sample_3",
      "material_state": "tested at 1000 °C",
      "attributes": {
        "description": "α-Nb2C precipitates act as hard obstacles that trap dislocations and hinder their motion during tensile deformation"
