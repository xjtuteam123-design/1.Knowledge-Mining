      "evidence": [
        {
          "page": 8,
          "section": "4.1 Deformation behavior and strengthening mechanism",
          "quote": "This phenomenon indicates that the α-Nb2C precipitate has act as a hard obstacle that traps dislocations and hinders their motion during tensile deformation, thereby generates a dispersion strengthening role in the L-DED Nb–2TiC alloy.",
          "table": null,
          "figure": null,
          "chunk_id": "6edc9158946e26a7:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "type": "Mechanism",
      "name": "solid-solution strengthening",
      "sample_id": "sample_3",
      "material_state": "as-built",
      "attributes": {
        "description": "Ti atoms substitute for Nb atoms in the matrix, causing lattice contraction"
      },
      "evidence": [
        {
          "page": 5,
          "section": "3.1 TiC nanoparticle effect on microstructure",
          "quote": "a gradual rightward shift with increasing TiC content, consistent with lattice contraction resulting from the substitution of smaller Ti atoms (atomic radius ~1.40 Å) for Nb atoms (atomic radius ~1.45 Å) in the matrix.",
          "table": null,
          "figure": null,
          "chunk_id": "6edc9158946e26a7:part:001"
