  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dynamic recovery suppression",
      "category": "deformation",
      "sample_id": "sample_3",
      "material_state": "rolled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": null,
          "section": "Results",
          "quote": "compared with RT rolling, the dynamic recovery was suppressed to a greater extent when rolled at lower temperature (LNT), which leads to a higher d islocation density, thus causing the higher degree of work hardening",
          "table": null,
