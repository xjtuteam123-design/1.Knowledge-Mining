    },
    {
      "id": "mechanism_2",
      "name": "transformation toughening",
      "category": "toughening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 435,
          "section": "18.3.2 Zirconia Ceramics",
          "quote": "When a crack is present in PSZ (and in related ZrO2 toughened materials such as TZP) the stress ﬁeld near the crack tip causes the metastable t-ZrO 2 to transform to the monoclinic symmetry. The transformation absorbs energy which would otherwise assist in advancing the crack, thereby increasing the resistance to crack growth, hence the use of the term ‘Transformation Toughening ’.",
          "table": null,
          "figure": null,
          "chunk_id": "8fa57f52b825b3bc:part:031"
        }
      ]
    },
    {
