      "evidence": [
        {
          "page": "2",
          "section": "2. Experiment",
          "quote": "During the LDED process, the laser beam scanned along a preset scanning track and moved at a speed of 5 mm/s. At the same time, the DD6 powders were coaxially injected into the molten pool at a rate of 10 g/min and deposited along the building direction layer by layer on the single-crystal substrate. The building direction was parallel to the crystallographic orientation of the [001] plane of the substrate. The height of each deposition layer was 0.35-0.4 mm.",
          "table": null,
          "figure": null,
          "chunk_id": "473edb156c8e93d5:part:001"
