  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solute partitioning",
      "category": "solidification",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "9",
          "section": null,
          "quote": "Many high γ′ alloys printed using PBF show a bimodal γ′ distribution [106, 116, 127, 131, 135]. Based on solidification theory, as the melt pool solidifies, elements partition either to the dendritic core or interdendritic regions [53].",
          "table": null,
          "figure": null,
          "chunk_id": "221e049a838d9140:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "solute trapping",
      "category": "solidification",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "15",
