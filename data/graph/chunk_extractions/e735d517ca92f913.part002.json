  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "sluggish diffusion",
      "category": "diffusion",
      "sample_id": "sample_2",
      "material_state": "as-sintered",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 8,
          "section": null,
          "quote": "Mo also has a melting point, which has been known to increase the activation energy (Q) for high temperature deformation [27]. In addition, Tsai et al. [30] showed that a higher the normalized activation energy (Q/Tm, where Tm is the melting point), the slower the diffusion rate, which implies that Mo enhances the sluggish diffusion effect in HEAs.",
          "table": null,
          "figure": null,
          "chunk_id": "e735d517ca92f913:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "solid-solution strengthening",
      "category": "strengthening mechanism",
      "sample_id": "sample_2",
      "material_state": "as-sintered",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 8,
          "section": null,
          "quote": "C2 had the highest atomic size difference at 2.24 compared to 1.7 for C1 which emphasizes the role played by Mo to distort the lattice and increase the strength by restricting the dislocation movement.",
          "table": null,
          "figure": null,
          "chunk_id": "e735d517ca92f913:part:002"
        }
      ]
    }
  ],
