      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3.1. Microstructures of the Cr-rich FCC phase",
          "quote": "the comparable atomic radii of Cr and Ni (Cr: 1.27 Å, Ni: 1.24 Å) enabled it a larger diffusion rate and a lower diffusion energy barrier during vacancy-mediated diffusion processes",
