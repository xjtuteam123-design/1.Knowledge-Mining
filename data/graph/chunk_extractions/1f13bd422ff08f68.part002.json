  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "precipitation hindering of dislocation motion",
      "category": "strengthening",
      "sample_id": "sample_3",
      "material_state": "aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": "4. Results and discussion",
          "quote": "precipitates create obstacles for dislocation motion. Therefore, thanks to their hindering effect on plastic deformation alloys are notably stronger so that the irrecoverable strain does not initiate until 1000 MPa.",
          "table": null,
          "figure": null,
          "chunk_id": "1f13bd422ff08f68:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "restriction of martensite variant formation by precipitates",
      "category": "microstructural constraint",
      "sample_id": "sample_3",
      "material_state": "aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": "4. Results and discussion",
          "quote": "Since the precipitates cannot transform, their increase in volume results in less transformable material within the matrix that limits the martensite variants formation to regions in between these precipitates.",
          "table": null,
          "figure": null,
          "chunk_id": "1f13bd422ff08f68:part:002"
        }
      ]
