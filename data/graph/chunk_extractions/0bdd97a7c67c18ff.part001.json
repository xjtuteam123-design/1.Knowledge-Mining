      "evidence": [
        {
          "page": 1,
          "section": "2. Experimental",
          "quote": "SCM Metal Products supplied two strips of LOX (low oxygen) grade GlidCop\"' CuA125 alloyed with 9.6 wt% Nb. Niobium particles were added to the starting GlidCop T\" powder to serve as an additional strengthening phase. Preliminary microscopy indicated a size range of niobium particulates of 10-100 nm, with a roughly spherical morphology. The alloy also contained 0.25 wt% aluminum in the form of Al2O3 formed by a proprietary internal oxidation process.",
          "table": null,
          "figure": null,
          "chunk_id": "0bdd97a7c67c18ff:part:001"
        },
        {
          "page": 2,
          "section": "2. Experimental",
          "quote": "The two strips will be referred to as Heat A and Heat B. The final cold work (CW) level for both sheets was 92%.",
          "table": null,
          "figure": null,
          "chunk_id": "0bdd97a7c67c18ff:part:001"
        },
        {
          "page": 2,
          "section": "2. Experimental",
          "quote": "All three of the GlidCop\"' alloys contained ~ 250 ppm of boron, which was used to remove any excess oxygen remaining after the internal oxidation process.",
          "table": null,
          "figure": null,
          "chunk_id": "0bdd97a7c67c18ff:part:001"
        },
        {
          "page": 4,
          "section": "3.2. Irradiated",
          "quote": "Half of the GlidCop\"' -Nb Heat A specimens irradiated to 35 dpa at 706 K exhibited an unusual change in the elastic region of the tensile curve, resulting in a lower yield strength than that measured for the other Heat A specimens.",
          "table": null,
          "figure": null,
          "chunk_id": "0bdd97a7c67c18ff:part:001"
        }
      ]
