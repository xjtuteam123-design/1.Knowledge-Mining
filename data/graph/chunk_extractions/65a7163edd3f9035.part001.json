  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "pinning of dislocation network nodes by Re",
      "category": "dislocation strengthening",
      "sample_id": "sample_2",
      "material_state": "crept",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "3.2.1",
          "quote": "it can be found that some Re atoms are pinned at the nodes of the dislocation network, it indicates that the addition of Re has a certain pinning effect on the nodes of dislocation network, which protects the damage and deformation of dislocation network.",
          "table": null,
          "figure": "3(b), 3(c)",
          "chunk_id": "65a7163edd3f9035:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "reduction of dislocation density by Re",
      "category": "dislocation density",
      "sample_id": "sample_2",
      "material_state": "crept",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "3.2.2",
          "quote": "the dislocation density of the sample with Re addition is always lower than that of the sample without Re addition during creep. The dislocation density reflects the creep plastic deformation of the alloys, the lower the dislocation density is, the smaller the creep plastic deformation is.",
          "table": null,
          "figure": "4",
          "chunk_id": "65a7163edd3f9035:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "Re segregation at dislocations in gamma-prime dragging dislocations",
      "category": "dislocation drag",
      "sample_id": "sample_2",
      "material_state": "crept",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "1",
          "section": "Abstract",
          "quote": "Re segregates at the dislocations in the γ0 precipitates phase and prevents the dislocation from cutting into the γ0 phase by dragging dislocations at the tertiary creep stage",
