  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "liquid film tearing",
      "category": "hot cracking",
      "sample_id": "sample_1",
      "material_state": "as-deposited",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 12,
          "section": "4",
          "quote": "The liquid film then tears under tensile stress depending on the cooling rate. Hot cracks based on liquid film tearing were primarily distributed in the corner and bottom of the deposition sample; this hot cracking process corresponds to the Type A hot cracking mechanism illustrated in Fig. 14.",
          "table": null,
          "figure": "Fig. 14",
          "chunk_id": "33088691caf8ac69:part:003"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "solid-bridging fracture",
      "category": "hot cracking",
      "sample_id": "sample_1",
      "material_state": "as-deposited",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 12,
          "section": "4",
          "quote": "even if a liquid film is not formed in the inter-dendrite and solid-bridging regions, a solid-bridging fracture is inevitable when the tensile stress is sufficiently large. This hot crack formation mechanism occurred during the last stage of solidification, and the columnar dendrites grew sufficiently, as illustrated by the Type B hot cracking mechanism in Fig. 14.",
          "table": null,
          "figure": "Fig. 14",
          "chunk_id": "33088691caf8ac69:part:003"
        }
      ]
    },
