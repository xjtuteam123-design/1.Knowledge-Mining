  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "Mo substitution on Al sublattice",
      "category": "site preference",
      "sample_id": "sample_1",
      "material_state": "as-cast",
      "assertion_level": "experimentally_observed",
      "evidence": [
        {
          "page": "3",
          "section": "4.1. 4d elements Mo and Ru in Ni3Al",
          "quote": "The best fit (R-factor 0.84%) was obtained for the Mo(Al) structure model. In this model, Mo substitutes for Al in the Ni3Al crystal lattice.",
          "table": null,
          "figure": null,
          "chunk_id": "04b1636a58a0f8e8:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "Ru substitution on Ni sublattice",
      "category": "site preference",
      "sample_id": "sample_2",
      "material_state": "annealed",
      "assertion_level": "experimentally_observed",
      "evidence": [
        {
          "page": "3",
          "section": "4.1. 4d elements Mo and Ru in Ni3Al",
          "quote": "The fit was obtained with the model where Ru substitutes for Ni in the crystal lattice of Ni3Al.",
          "table": null,
          "figure": null,
          "chunk_id": "04b1636a58a0f8e8:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "Hf substitution on Al sublattice",
      "category": "site preference",
      "sample_id": "sample_3",
      "material_state": "as-cast",
      "assertion_level": "experimentally_observed",
      "evidence": [
        {
          "page": "4",
          "section": "4.2. 5d elements Hf, W and Re in Ni3Al",
          "quote": "The best fit (R-factor 0.96%) was obtained for the Hf(Al) structure model. In this model, the first shell consists of 12 Ni atoms.",
          "table": null,
          "figure": null,
          "chunk_id": "04b1636a58a0f8e8:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "W substitution on Al sublattice",
      "category": "site preference",
      "sample_id": "sample_4",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "6",
          "section": "5. Discussion",
          "quote": "The discrepancy between the measured and calculated W—Al distance, along with the lower defect formation energy of W on the aluminium lattice site, indicated that the W(Al) fitting model should be adopted as more relevant for tungsten in Ni3Al despite the somewhat higher value of the R-factor.",
          "table": null,
          "figure": null,
          "chunk_id": "04b1636a58a0f8e8:part:001"
        }
      ]
    },
    {
      "id": "mechanism_5",
      "name": "Re substitution on Al sublattice",
      "category": "site preference",
      "sample_id": "sample_5",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "6",
          "section": "5. Discussion",
          "quote": "The same arguments were applied when we decided to dismiss the Re(Ni) model for the Ni3Al:Re EXAFS fit, since the fitted first-shell Re—Ni bond length of 2.503 Å was too far from the calculated value of 2.523 Å. Also, the higher defect formation energy of Re on the Ni site suggested that we should adopt the Re(Al) model.",
          "table": null,
          "figure": null,
          "chunk_id": "04b1636a58a0f8e8:part:001"
        }
      ]
    },
    {
      "id": "mechanism_6",
      "name": "outward lattice relaxation around Hf",
      "category": "lattice relaxation",
      "sample_id": "sample_3",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "5",
          "section": "5. Discussion",
          "quote": "Our calculations predict that the largest lattice relaxation should be expected in the case of Hf doping, regardless of the actual site occupancy. For Hf substituting on Al, there is an outward relaxation of ~2.77%.",
          "table": null,
          "figure": null,
          "chunk_id": "04b1636a58a0f8e8:part:001"
        }
      ]
    }
