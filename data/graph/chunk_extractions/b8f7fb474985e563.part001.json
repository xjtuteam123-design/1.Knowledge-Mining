  "phases_and_microstructures": [
    {
      "id": "microstructure_1",
      "type": "Microstructure",
      "name": "dislocation structure",
      "sample_id": "sample_3",
      "material_state": "deformed",
      "attributes": {
        "phase_fraction": null,
        "size": null,
        "morphology": "cavities with broken boundaries, isolated dislocations within holes are fixed, fairly uniform dislocation distribution",
        "location": null,
        "composition": null,
        "identification_status": "experimental"
      },
      "evidence": [
        {
          "page": "4",
          "section": "3. Results and discussion",
          "quote": "By alloying platinum with rhodium the size of the cavity decreases almost twice, leading to distortion of the perfect dislocation structure: cavities have broken boundaries, isolated dislocations within holes are fixed.",
          "table": null,
          "figure": "Fig. 7",
          "chunk_id": "b8f7fb474985e563:part:001"
        }
      ]
    }
  ],
  "property_observations": [],
  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid-solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_6",
      "material_state": "tested",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3. Results and discussion",
          "quote": "When forming a solid solution of platinum with rhodium, where there is a big difference in the values of lattice defects energy of basic and alloying element (γPt = 120 kJ/m2 and γRh = 180 kJ/m2) [29], any increase in the concentration of rhodium results in solid solution strengthening, as after all, our results have confirmed.",
          "table": null,
          "figure": null,
          "chunk_id": "b8f7fb474985e563:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "dislocation motion blocking",
      "category": "creep strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3. Results and discussion",
          "quote": "An important mechanism in platinum strengthening, using platinum group metals (primarily rhodium), at high temperatures, which controls the creep process, is blocking (preventing) the movement of dislocations.",
          "table": null,
          "figure": null,
          "chunk_id": "b8f7fb474985e563:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "creep dislocation mechanism",
      "category": "creep deformation",
      "sample_id": "sample_6",
      "material_state": "tested",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "5",
          "section": "4. Conclusion",
          "quote": "For PtRh40 alloy creep curves have the form characteristic for creep of pure metals, where plastic deformation at high temperatures is controlled by creep dislocation mechanism.",
          "table": null,
          "figure": null,
          "chunk_id": "b8f7fb474985e563:part:001"
        }
      ]
