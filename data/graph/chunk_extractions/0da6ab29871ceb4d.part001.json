      "evidence": [
        {
          "page": 2,
          "section": "2. Experimental Section",
          "quote": "The GH3536 alloy was fabricated using the EOS-M290 Selective Laser Melting (SLM) system (EOS Gmbh, Shanghai, China), which is equipped with a solid-state fiber laser with a maximum power of 400 W and a build volume of 250 mm × 250 mm × 325 mm. The process parameters for fabricating the GH3536 alloy were as follows: laser power of 280 W, scanning speed of 1250 mm/s, scanning distance of 110 µm, and powder layer thickness of 40 µm.",
          "table": null,
          "figure": null,
          "chunk_id": "0da6ab29871ceb4d:part:001"
