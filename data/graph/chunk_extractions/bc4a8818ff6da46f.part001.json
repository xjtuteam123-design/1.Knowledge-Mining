      "evidence": [
        {
          "page": 2,
          "section": "2. Experimental section",
          "quote": "Nanocrystalline Cu-3 at. % Zr alloys were fabricated by ball milling powders of Cu (Alfa Aesar, 99.99 %, 170 + 400 mesh) and Zr (Micron Metals, 99.7 %, 50 mesh) for 10 h. Ball milling was conducted in a SPEX SamplePrep 8000 M high-energy ball mill in a glovebox filled with Ar gas at an O2 level < 0.05 ppm to minimize oxidation. A hardened steel vial and milling balls were used, with a ball-to-powder weight ratio of 10:1. In order to prevent excessive cold welding, 1 wt.% stearic acid was added as a process control agent.",
          "table": null,
          "figure": null,
          "chunk_id": "bc4a8818ff6da46f:part:001"
        }
      ]
