      "id": "process_1",
      "sample_id": null,
      "sequence": 1,
      "method": "vacuum arc melting",
      "parameters": {
        "temperature_c": null,
        "time": "3-5 minutes per melt",
        "pressure": "<5e-3 Pa (evacuation), 0.02 MPa Ar (fill)",
