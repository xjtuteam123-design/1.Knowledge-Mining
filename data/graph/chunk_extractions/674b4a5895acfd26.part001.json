        "cooling_method": null,
        "deformation": null,
        "strain_rate": null,
        "laser_power_w": null,
        "scan_speed": null,
        "layer_thickness": null,
        "other": {
          "current": "380-400 A",
          "remelting_times": 10,
          "Ti_getter_melting": "5 minutes"
        }
      },
      "input_state": "pure metals (Al, Mo, Nb, Ti, V, Zr, purity >= 99.99%)",
      "output_state": "as-cast ingot",
      "evidence": [
        {
          "page": null,
          "section": "2. Materials and methods",
          "quote": "During refining, evacuate the arc furnace chamber to a pressure below 5 × 10 3 Pa, then fill it with high-purity argon gas to 0.02 MPa to guarantee the alloy is not oxidized during the melting process. To further reduce the oxygen concentration inside the furnace, Ti is melted once for 5 minutes to eliminate leftover oxygen in the electric arc furnace. Due to the high content of refractory elements in RHEA, increasing the current intensity and flipping times during melting is necessary. Repeated remelting ensures that any segregation or compositional inhomogeneities are minimized. The alloy ingot is melted 10 times in an electric arc furnace, each lasting 3 – 5 minutes, and the current is increased to 380 – 400 A to ensure sufficient mixing of refractory metal elements.",
          "table": null,
          "figure": null,
          "chunk_id": "674b4a5895acfd26:part:001"
        }
      ]
    }
