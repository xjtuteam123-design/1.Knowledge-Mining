  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "tetragonal distortion of L12 lattice by Cr on Pt sites",
      "category": "lattice instability",
      "sample_id": "sample_6",
      "material_state": "calculated",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "8",
          "section": "6. First principles calculations",
          "quote": "The calculated results demonstrate that Cr residing on Pt sites leads to a tetragonal distortion of the L1 2-ordered cell with a = 390.3 pm and c = 393.2 pm closely to the structure type Pb 3Sr with a = 383.2 pm and c = 389.4 pm observed by Stadelmaier et al. [39].",
          "table": null,
          "figure": null,
          "chunk_id": "91d64c18014c8d61:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "softening of lattice due to density-of-states peak at Fermi level",
      "category": "phase instability",
      "sample_id": "sample_6",
      "material_state": "calculated",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "8",
          "section": "6. First principles calculations",
          "quote": "A closer look to the Fermi level, Fig. 13 b, exhibits a local maximum of the total density of states for Pt 3Al and Pt 3Al with 3.125 at.% Cr atoms occupying the Pt sublattice at the Fermi level. This is an indication for a structural phase instability leading to a softening of the lattice which can be released by the onset of magnetism or a structural transformation [40].",
          "table": null,
          "figure": "13",
          "chunk_id": "91d64c18014c8d61:part:002"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "L12 phase stabilization by Ni addition via reduced formation enthalpy",
      "category": "phase stabilization",
      "sample_id": "sample_2",
      "material_state": "heat-treated",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "9",
          "section": "7. Conclusion",
          "quote": "The combination of ALCHEMI experiments and the calculated enthalpy of formation for c0-phases in the Pt 82Al12Cr6 and the Pt 77Al12Cr6Ni5 alloys showed that the addition of Ni is resulting in a reduction of the formation enthalpy and the lattice parameter and is therefore additionally stabilizing the L1 2-ordered structure.",
          "table": null,
          "figure": null,
          "chunk_id": "91d64c18014c8d61:part:002"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "Cr site preference on Al sublattice stabilizing L12 structure",
