  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid-solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "solution treated at 790 °C for 1 h and water quenched",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "4.1",
          "quote": "The strength of the alloy in the α/β solution condition is somewhat superior to that of in the β solution condition, a 180 MPa difference in yield strength being mentioned above.",
          "table": null,
          "figure": null,
          "chunk_id": "8daf7315931441c6:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "grain boundary pinning",
      "category": "microstructural",
      "sample_id": "sample_1",
      "material_state": "solution treated at 790 °C for 1 h and water quenched",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "4.1",
          "quote": "the important characteristic of the primary α phase concerns its ability to pin the prior β grain boundaries and reduce their mobility, which therefore limits the recrystallization and grain growth of the β grain",
          "table": null,
          "figure": null,
          "chunk_id": "8daf7315931441c6:part:002"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "slip",
      "category": "deformation",
      "sample_id": "sample_1",
      "material_state": "tensile tested after solution treatment at 790 °C for 1 h and water quenching",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3.2",
          "quote": "the absence of SIM or twinning in Fig. 6(a), corresponding to the alloy solution treated at 790 1C, is supposed that only the slip mode dominates the deformation mechanism.",
          "table": null,
          "figure": "Fig. 6",
          "chunk_id": "8daf7315931441c6:part:002"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "stress or strain induced martensite (SIM)",
      "category": "deformation",
      "sample_id": "sample_2",
      "material_state": "tensile tested after solution treatment at 850 °C for 1 h and water quenching",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3.2",
          "quote": "the presence of α″ and some other plate-like features. The former refers to the stress or strain induced martensite (SIM) and the latter corresponds to slip bands.",
          "table": null,
          "figure": "Fig. 6",
          "chunk_id": "8daf7315931441c6:part:002"
        }
      ]
