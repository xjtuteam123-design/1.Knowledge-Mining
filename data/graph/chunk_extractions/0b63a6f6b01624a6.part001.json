      "evidence": [
        {
          "page": "2",
          "section": "Experimental procedures",
          "quote": "After arc melting, these alloy ingots were sealed in a silica tube with a small amount of argon gas and solution-treated at 1523 K for 10.8 ks. This solution-treatment temperature was in the B2 (austenitic) phase region, well above the austenite ﬁnish temperature and well below the melting temperature of equiatomic Ti–Pt alloys [37]. Then, the alloy ingots were ice–water quenched for diffusionless martensitic phase transformation.",
          "table": null,
          "figure": null,
          "chunk_id": "0b63a6f6b01624a6:part:001"
        }
