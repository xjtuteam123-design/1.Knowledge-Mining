    {
      "id": "alloy_system_1",
      "name": "Nb-Mo-Zr alloy",
      "material_category": "Nb-based refractory alloy",
      "evidence": [
        {
          "page": "11",
          "section": "DETAILED DESCRIPTION OF THE INVENTION",
          "quote": "Applicants disclose a Nb—Mo—Zr alloy comprising Nb, about 5 atomic percent to about 20 atomic percent Mo, preferably about IO atomic percent to about 20 atomic percent Mo, more preferably about 10 atomic percent to about 15 atomic percent Mo, and about 2 atomic percent to about 35 atomic percent Zr, preferably about 5 atomic percent to about 15 atomic percent Zr, more preferably about 5 atomic percent to about IO atomic percent Zr.",
          "table": null,
          "figure": null,
          "chunk_id": "9facd1ac95660800:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_2",
      "name": "Nb-Si alloy",
      "material_category": "Nb-based refractory alloy",
      "evidence": [
        {
          "page": "11",
          "section": "BACKGROUND OF THE INVENTION",
          "quote": "There has been extensive efforts put forth to solve the above mention problems including research on Nb alloys containing Si, which main goal is to improve both high temperature strength and oxidation resistance; however, Nb—Si alloys are generally brittle at temperatures 40000 C. and they have not found practical use yet.",
          "table": null,
          "figure": null,
          "chunk_id": "9facd1ac95660800:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_3",
      "name": "refractory complex concentrated alloy",
      "material_category": "RCCA/RHEA",
      "evidence": [
        {
          "page": "11",
          "section": "BACKGROUND OF THE INVENTION",
          "quote": "Refractory complex concentrated alloys (RCCAs) or refractory high entropy alloys (RHEAs) are another promising direction of research but such research has yet to result in a Nb-based refractory alloy that is known to solve the aforementioned problems.",
          "table": null,
          "figure": null,
          "chunk_id": "9facd1ac95660800:part:001"
        }
      ]
    }
