      "id": "mechanism_4",
      "name": "Ostwald ripening",
      "category": "coarsening",
      "sample_id": "sample_4",
      "material_state": "annealed at 500°C for 100 h",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3.3 Thermal Stability",
          "quote": "Therefore, the hardness reduction at this temperature is due to the increased diffusivity of alloying elements in Al matrix and subsequently the coarsening of Al12(Fe,V)3Si precipitates.",
          "table": null,
          "figure": null,
          "chunk_id": "d73478f7848ddc4d:part:001"
        }
      ]
    },
    {
      "id": "mechanism_5",
      "name": "grain boundary diffusion",
      "category": "diffusion",
      "sample_id": "sample_4",
      "material_state": "annealed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3.3 Thermal Stability",
          "quote": "Since the activation energy for diffusion across the grain boundaries is about the half of that for lattice diffusion, the grain boundary diffusion is the dominant mechanism of diffusion in nanostructured materials",
          "table": null,
          "figure": null,
          "chunk_id": "d73478f7848ddc4d:part:001"
        }
      ]
