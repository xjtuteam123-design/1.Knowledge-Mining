      "id": "mechanism_3",
      "name": "precipitation hardening",
      "category": "strengthening",
      "sample_id": "sample_4",
      "material_state": "as-hot pressed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3.4.1 Room Temperature Compressive Properties",
          "quote": "This significant effect of Al12(Fe,V)3Si precipitates on the yield strength is due to their nanoscale size (<50 nm). Moreover, increasing the volume percentage of precipitates in the alloys leads to a decrease in the mean distance between them, which makes dislocation movement more difficult. It consequently increases the strength and reduces the ductility.",
          "table": null,
          "figure": null,
          "chunk_id": "d73478f7848ddc4d:part:001"
        }
      ]
    },
