    {
      "id": "process_2",
      "sample_id": "sample_4",
      "sequence": 1,
      "method": "laser powder bed fusion (LPBF)",
      "parameters": {
        "temperature_c": null,
        "time": null,
        "pressure": null,
        "atmosphere": "argon",
        "cooling_method": null,
        "deformation": null,
        "strain_rate": null,
        "laser_power_w": 150,
        "scan_speed": 600,
        "layer_thickness": "30 μm",
        "other": {
          "hatch distance (h)": "102 μm",
          "laser spot size": "60 μm",
          "scanning strategy": "one-way (unidirectional)",
          "scan vector rotation": "79° per layer",
          "residual oxygen content": "<100 ppm",
          "relative density": ">99%",
          "sample dimensions": "cylindrical samples 7 mm in diameter and 44.5 mm in height",
          "build orientations": "0°, 45°, and 90° with respect to the building direction"
        }
      },
      "input_state": "gas-atomized powder",
      "output_state": "as-built",
      "evidence": [
        {
          "page": 2,
          "section": "2.1 Sample preparation",
          "quote": "An SLM machine (AconityMINI, Germany) equipped with an ytterbium fiber laser was employed to produce cylindrical samples 7 mm in diameter and 44.5 mm in height. Argon was used as a protective gas to prevent the powder from oxidizing. The residual oxygen content was kept below 100 ppm during processing. All the samples were produced with a layer thickness (t) of 30 μm. In our previous LPBF optimization studies [57], we investigated the behavior of Al-4Fe-3Cr-2Ti (wt.%) powder (P1) during processing. In that study, the parameters used to achieve the densest samples were as follows: a laser power (P) of 150 W, hatch distance (h) of 102 μm, and laser scanning speed (v) of 600 mm/s. A laser spot size of 60 μm and a one-way (unidirectional) scanning strategy were used. For each layer, the scanning vectors were rotated by 79°.",
          "table": null,
          "figure": null,
          "chunk_id": "adca47d64ad2a318:part:001"
        }
      ]
    }
