  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "Ostwald ripening",
      "category": "coarsening",
      "sample_id": "sample_4",
      "material_state": "aged at 900 °C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 8,
          "section": null,
          "quote": "LSW model of matrix diffusion-limited coarsening for the quasisteady state was based on Ostwald ripening mechanism that involves dissolution of shrinking particles via detachment of solute atoms and their diffusion via matrix through the so-called evaporation-condensation (EC) process",
          "table": null,
          "figure": null,
          "chunk_id": "1003f31fb1b53c3a:part:002"
        }
      ]
    },
