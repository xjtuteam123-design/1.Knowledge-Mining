  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "pest oxidation",
      "category": "oxidation",
      "sample_id": "sample_1",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "10",
          "section": "4.1",
          "quote": "It is suggested that the pest oxidation of KZ3 occurred because of the generation of inter-granular cracks in the brittle (Nb,Ti)3Si, and the formation of voluminous oxides at its grain boundaries that increased the oxygen intake and led to linear catastrophic oxidation.",
          "table": null,
          "figure": null,
          "chunk_id": "ed3935659d2d5305:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "inward oxygen diffusion",
      "category": "diffusion",
      "sample_id": "sample_3",
      "material_state": "heat-treated",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "11",
          "section": "4.3",
          "quote": "This is attributed to the lowering of the diffusivity of oxygen in (Nb,Ti)ss in the presence of Cr [10].",
          "table": null,
          "figure": null,
          "chunk_id": "ed3935659d2d5305:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "oxide scale cracking",
      "category": "mechanical",
      "sample_id": "sample_2",
      "material_state": "oxidized",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3.2",
          "quote": "It is suggested that when the plateau was reached, generation of growth stresses caused the formation of cracks in the oxide scale that allowed further attack of the alloy by oxygen.",
          "table": null,
          "figure": null,
          "chunk_id": "ed3935659d2d5305:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "synergy of Ti, Cr and Al additions",
      "category": "compositional",
      "sample_id": "sample_4",
      "material_state": "heat-treated",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "12",
          "section": "5",
          "quote": "In the Cr- and Al-containing alloys the internal oxidation zone was almost eliminated, which would suggest that the diffusivity of oxygen through (Nb,Ti)ss was reduced because of the synergy of the Ti, Cr and Al additions.",
          "table": null,
          "figure": null,
          "chunk_id": "ed3935659d2d5305:part:001"
        }
      ]
    }
  ],
