  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid-solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_3",
      "material_state": "thermomechanically processed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 11,
          "section": null,
          "quote": "the addition of Si can overwhelm the strength–ductility trade-off of the CoCrFeNi HEA, which was attributed to the synthetical effect of the improved solid-solution strengthening and a reduced SFE.",
          "table": null,
          "figure": null,
          "chunk_id": "4c128574a581e7c7:part:003"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "twinning",
      "category": "deformation",
      "sample_id": "sample_3",
      "material_state": "thermomechanically processed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 11,
          "section": null,
          "quote": "the activation of cross slip in the CoCrFeNi HEA is gradually suppressed, and the planar slip of dislocation, stacking faults, and deformation nanotwins become the dominant plastic defamation mechanism.",
          "table": null,
          "figure": null,
          "chunk_id": "4c128574a581e7c7:part:003"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "transformation-induced plasticity (TRIP)",
      "category": "deformation",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 13,
          "section": null,
          "quote": "Its essence is to obtain two pivotal benefits through the transformation of austenite to martensite under plastic deformation [118,259–261]: interface strengthening resulting from a dual-phase microstructure; work hardening induced by phase transformation.",
          "table": null,
          "figure": null,
          "chunk_id": "4c128574a581e7c7:part:003"
        }
      ]
    },
