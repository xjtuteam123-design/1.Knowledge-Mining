      "method": "spark plasma sintering (SPS)",
      "parameters": {
        "temperature_c": 1100,
        "time": "10 min",
        "pressure": "50 MPa",
        "atmosphere": "vacuum (residual cell pressure < 8 Pa)",
        "cooling_method": null,
        "deformation": null,
        "strain_rate": null,
        "laser_power_w": null,
        "scan_speed": null,
        "layer_thickness": null,
        "other": {
          "heating_rate_600_to_1000C": "100 °C/min",
