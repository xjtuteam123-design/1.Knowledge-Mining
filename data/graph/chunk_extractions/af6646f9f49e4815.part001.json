        }
      },
      "input_state": "MAed powder",
      "output_state": "as-sintered bulk",
      "evidence": [
        {
          "page": 2,
          "section": "Experimental details",
          "quote": "The MAed powders were sintered to 1 100 /C14 C with a holding pressure of 50 MPa in vacuum (residual cell pressure < 8 Pa) and holding time of 10 min. The samples were heated to 600 /C14 C within 6 min, while from 600 /C14 Ct o 10 0 0/C14 C and from 1000 /C14 Ct o1 1 0 0/C14 C, heating rates of 100 /C14 C/min and 50 /C14 C/min were used, respectively.",
          "table": null,
          "figure": null,
