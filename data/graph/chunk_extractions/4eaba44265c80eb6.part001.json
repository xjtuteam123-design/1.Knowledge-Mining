          "rotation_speed": "300 r/min",
          "ball_to_powder_weight_ratio": "10:1",
          "single_round_time": "30 min",
          "interval_between_rounds": "15 min",
          "mill_type": "planetary ball mill (MSK-SFM-I)"
        }
      },
      "input_state": "elemental powder mixture",
      "output_state": "alloyed RHEA powder",
      "evidence": [
        {
          "page": "2",
          "section": "2 Experimental",
          "quote": "The RHEA powders with nominal composition of Ti62Nb12Mo12Ta12W2 (atom ratio) were prepared using MA method. The MA process was carried out using the planetary ball mill (MSK-SFM-I). High-purity (≥ 99.9 wt%) Ti (< 100 μm), Nb (< 100 μm), Mo (< 1 μm), Ta (< 5 μm) and W (< 1 μm) powders and the stainless-steel grinding ball were mixed and sealed in a stainless-steel grinding tank in a weight ratio of 10:1. The rotation speed was set as 300 r/min. The running time of a single round is 30 min, and an interval of 15 min was added between two adjacent rounds. The total effective milling time is 50 h, and the alloyed RHEA powder after milling was collected. To prevent the oxidation of powder, powder loading and extraction processes were completed in Argon atmosphere.",
          "table": null,
          "figure": null,
          "chunk_id": "4eaba44265c80eb6:part:001"
        }
      ]
    },
    {
      "id": "process_2",
      "sample_id": "sample_2",
      "sequence": 1,
      "method": "spark plasma sintering (SPS)",
      "parameters": {
        "temperature_c": "1550",
        "time": "10 min",
        "pressure": "50 MPa (axial)",
        "atmosphere": "vacuum or inert (not specified)",
        "cooling_method": "furnace cooling to 100 °C",
        "deformation": null,
        "strain_rate": null,
        "laser_power_w": null,
        "scan_speed": null,
        "layer_thickness": null,
        "other": {
          "mold_material": "graphite",
          "mold_inner_diameter": "20 mm"
        }
      },
      "input_state": "alloyed RHEA powder",
      "output_state": "sintered bulk at 1550 °C",
      "evidence": [
        {
          "page": "2",
          "section": "2 Experimental",
          "quote": "Then, the alloyed powder was loaded into a high-strength graphite mold with an inner diameter of 20 mm and held at 1550–1700 °C for 10 min under an axial pressure of 50 MPa. The sintering process was conducted using SPS-20T-10-III system",
          "table": null,
          "figure": null,
          "chunk_id": "4eaba44265c80eb6:part:001"
        }
      ]
    },
