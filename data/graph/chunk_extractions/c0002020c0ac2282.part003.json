  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solidification path",
      "category": "solidification",
      "sample_id": "sample_1",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 12,
          "section": "4.1",
          "quote": "Thus, with a combination of high Ru (6 at.%/9.6 wt.%) and low levels of Re (1.3 at.%/4 wt.%) and Al (14.3 at.%/6.1 wt.%), the solidification path for the Ru-containing multicomponent superalloy is quite similar to Ni-Al binary alloys and other conventional superalloys as follows: L→L1+γ→(γ+γ')eutectic+γ",
          "table": null,
          "figure": null,
          "chunk_id": "c0002020c0ac2282:part:003"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "Ru suppresses δ phase formation",
      "category": "phase stabilization",
      "sample_id": null,
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 11,
          "section": "4.1",
          "quote": "This indicates that Ru additions suppress δ phase formation during solidification and increase the solubility of Re in the liquid.",
