  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solidification cracking",
      "category": "solidification",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 8,
          "section": "5. Mechanisms of microcrack formation in nickel-based alloys",
          "quote": "The combined effects of thermal stresses from solidification and the temperature gradient within the grains can lead to the formation of solidification cracks.",
          "table": null,
          "figure": "Fig. 16",
          "chunk_id": "71d5d38ac2fec4c9:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "liquation cracking",
      "category": "liquation",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 8,
          "section": "5. Mechanisms of microcrack formation in nickel-based alloys",
          "quote": "Liquation cracks (LC) primarily originate from the formation of low-melting-point constituents — such as γ ′ phases, Laves phases, carbides, and borides — along interdendritic regions.",
          "table": null,
          "figure": "Fig. 16",
          "chunk_id": "71d5d38ac2fec4c9:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "solid solution strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 2,
          "section": "1. Introduction",
          "quote": "In nickel-based alloys, elements such as A1, Fe, Ti, W, Co, and Mo dissolve into the matrix or precipitate, enhancing solid solution strengthening [34,35].",
          "table": null,
          "figure": null,
          "chunk_id": "71d5d38ac2fec4c9:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "precipitation strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "This inherent conflict between crack formation and high performance poses a continuing challenge. Current studies lack consensus on dominant cracking mechanisms (e.g., solidification vs. liquation cracking) and fail to provide universally effective suppression strategies.",
          "table": null,
          "figure": null,
          "chunk_id": "71d5d38ac2fec4c9:part:001"
        }
      ]
    },
    {
      "id": "mechanism_5",
      "name": "grain-boundary strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 2,
          "section": "1. Introduction",
          "quote": "Specific grain boundaries and dendritic strengthening elements, such as B (Boron), Mg (Magnesium), and Ce (Cerium), can reinforce the grain boundaries and dendritic regions through interstitial atoms or second phases [36,37].",
          "table": null,
          "figure": null,
          "chunk_id": "71d5d38ac2fec4c9:part:001"
        }
      ]
    },
