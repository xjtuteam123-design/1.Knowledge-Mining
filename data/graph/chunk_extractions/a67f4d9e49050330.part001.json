  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "as-built",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3.3 High-temperature compression behaviour",
          "quote": "The incorporation of vanadium atoms into the titanium lattice and vice versa, along with chromium and aluminium atoms which induce lattice strain. This lattice strain impedes movement of dislocations thereby increasing compressive strength of the MEA at elevated temperatures.",
          "table": null,
          "figure": null,
          "chunk_id": "a67f4d9e49050330:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "precipitation hardening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "as-built",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": "4",
          "section": "3.3 High-temperature compression behaviour",
          "quote": "the presence of Al and Cr precipitates within the Ti–rich and V-rich phases also enhances mechanical properties of the MEA by impeding movement of dislocations, thus providing precipitation hardening.",
          "table": null,
          "figure": null,
          "chunk_id": "a67f4d9e49050330:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "reduced grain growth",
      "category": "microstructural stabilization",
      "sample_id": "sample_1",
      "material_state": "as-built",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3.3 High-temperature compression behaviour",
          "quote": "presence of multiple elements in Ti45V45Al5Cr5 MEA enhances its thermal stability through its phase decomposition and reducing its grain growth at the elevated temperatures. This helps to maintain its microstructure and contributes to its high compressive strength at the elevated temperature.",
          "table": null,
          "figure": null,
