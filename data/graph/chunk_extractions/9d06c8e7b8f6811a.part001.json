      "evidence": [
        {
          "page": 2,
          "section": "2.2 Experimental procedures",
          "quote": "Tensile samples were subjected to local rapid heat treatment by using high-frequency induction heating equipment (SYG-10AB, Guangdong Saiyang Intelligent Equipment Technology Co., ltd) consisting of an induction coil and induction power supply with output oscillation power of 10 kW and frequency of 600–1100 kHz. The heating duration could be controlled within 0.1 s, and the heating rate reached up to 400 °C/s. Each sample was dropped into a water bath to quench after high-frequency induction heating.",
          "table": null,
          "figure": null,
          "chunk_id": "9d06c8e7b8f6811a:part:001"
        }
