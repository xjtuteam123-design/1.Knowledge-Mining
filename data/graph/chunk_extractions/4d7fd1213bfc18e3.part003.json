  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid solution softening",
      "category": "mechanical",
      "sample_id": "sample_3",
      "material_state": "annealed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "17",
          "section": "E. Effect of Zr or Ga Addition on Hardness",
          "quote": "the Ga content of the 5-3 silicide phase has increased by ~ 1.6 at. pct on annealing, which indicates its role in solid solution softening",
          "table": null,
          "figure": null,
          "chunk_id": "4d7fd1213bfc18e3:part:003"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "crack deflection",
      "category": "fracture",
      "sample_id": "sample_2",
      "material_state": "annealed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "18",
          "section": "F. Effect of Zr or Ga Addition on Fracture Toughness",
          "quote": "The enhancement in crack path tortuosity caused by the process of crack deflection in a composite microstructure is reported to increase the energy absorbed for crack propagation, and thereby contribute to the enhancement of fracture toughness",
          "table": null,
          "figure": null,
          "chunk_id": "4d7fd1213bfc18e3:part:003"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "ductile phase toughening",
      "category": "fracture",
      "sample_id": "sample_2",
      "material_state": "annealed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "17",
          "section": "F. Effect of Zr or Ga Addition on Fracture Toughness",
          "quote": "the non-lamellar eutectic is more effective in the enhancement of fracture toughness, because of the reduced constraint to plastic flow of the ductile Nbss phase",
          "table": null,
          "figure": null,
          "chunk_id": "4d7fd1213bfc18e3:part:003"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "Ostwald ripening",
      "category": "diffusion",
      "sample_id": "sample_2",
      "material_state": "annealed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "15",
          "section": "B. Effect of Annealing on Microstructural Evolution",
