        }
      },
      "input_state": null,
      "output_state": "button",
      "evidence": [
        {
          "page": 2,
          "section": "2.1 Alloy synthesis",
          "quote": "Using an Arcast 200 (Arcast, Maine, USA) arc melter, 10 mL buttons were melted on an actively cooled Cu hearth in an ultra-high purity (UHP) Ar environment. The melt chamber was evacuated to a vacuum level of 10 mTorr and purged three times with UHP Ar before every melt. Electromagnetic stirring enhanced mixing of the melt, and the buttons were flipped and remelted 5 times to avoid dead zones and improve mixing to achieve an overall homogenous melt.",
          "table": null,
          "figure": null,
          "chunk_id": "9ef7aa04e8b94613:part:001"
        }
      ]
    },
