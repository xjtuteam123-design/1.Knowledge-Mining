      "evidence": [
        {
          "page": 121,
          "section": "Materials and Experimental Procedures",
          "quote": "The raw materials were commercial pure aluminum, pure magnesium and Al–20Si and Al–50Cu master alloys. The preheated pure aluminum, Al–20Si and Al–50Cu master alloys were placed inside the crucible. When the temperature of molten was 700 °C, the pure magnesium was added. After 5 min, the melt was degassed with 2 wt% C2Cl6 and the slag was skimmed. After that, the pouring temperature of the metal was 630 °C, and it was poured into a stainless steel container preheated to 600 °C. Then the stainless steel container was immediately transferred to electromagnetic stirrer. The stirrer was started at frequencies of 10 Hz for 20 s.",
          "table": null,
          "figure": null,
          "chunk_id": "06de421c56f19c3c:part:008"
        }
      ]
