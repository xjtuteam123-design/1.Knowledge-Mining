  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "matrix-diffusion controlled kinetics",
      "category": "diffusion",
      "sample_id": "sample_1",
      "material_state": "aged",
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 10,
          "section": "4.1.1",
          "quote": "Motejadded et al. [ 150 ] studied the γ ′ coarsening process in IC221M superalloy. It was shown that the γ ′ coarsening kinetics follows the LSW theory and the corresponding activation energy of 253.5 kJ / mol. The value was close to the diffusion activation energy of Al in Ni-matrix (284 kJ / mol), indicative of the matrix-diffusion controlled kinetics mechanism.",
          "table": null,
          "figure": null,
          "chunk_id": "0328da78bea7f6b8:part:002"
        }
      ]
    }
