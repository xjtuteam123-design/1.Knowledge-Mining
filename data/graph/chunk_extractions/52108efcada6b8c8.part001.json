      "evidence": [
        {
          "page": "2",
          "section": "2.1 Material preparation",
          "quote": "The raw materials are put into the dried BN crucible and melted through a vacuum medium frequency induction melting furnace. Before melting, the furnace chamber is evacuated to 6 × 10−2 Pa and then fill it with pure argon gas to 6 × 104 Pa. The melted eutectic alloy is then superheated and poured into MgO crucible. The melting temperature is about 1823 K.",
          "table": null,
          "figure": null,
          "chunk_id": "52108efcada6b8c8:part:001"
        }
      ]
    },
