  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "grain refinement",
      "category": "microstructural",
      "sample_id": "sample_1",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "4.1 Microstructure",
          "quote": "As reported in literatures [7,8,20], titanium alloys can be significantly refined by trace boron. In this paper, grains of Ti–B20–0.1B alloy have relatively small sizes of 176 ± 27 lm.",
          "table": null,
          "figure": null,
          "chunk_id": "3af2ebbe1cec0003:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "grain boundary pinning",
      "category": "microstructural",
      "sample_id": "sample_1",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "4.1 Microstructure",
          "quote": "effective pinning of TiB to the grain boundary can prevent grains from growing at high temperature [18], which improves the alloy formability and benefits the subsequent forging process.",
          "table": null,
          "figure": null,
          "chunk_id": "3af2ebbe1cec0003:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "load transfer by shear lag",
      "category": "mechanical",
      "sample_id": "sample_2",
      "material_state": "aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 7,
          "section": "4.2 Mechanical properties",
          "quote": "The reinforcement of trace TiB on strength of Ti–B20 is attributed to the load transfer by the shear lag mechanism [35,36], which can be proved by the fracture of TiB caused by its carrying (see Fig. 12).",
          "table": null,
          "figure": "Fig. 12",
          "chunk_id": "3af2ebbe1cec0003:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "micro-void accumulation toughness fracture",
      "category": "fracture",
      "sample_id": "sample_2",
      "material_state": "tensile tested",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3.2 Mechanical properties",
          "quote": "Massive dimples exist in fractographs of tensile samples (Fig. 11), which indicates the fracture mechanism of the alloy is micro-void accumulation toughness fracture.",
          "table": null,
          "figure": "Fig. 11",
          "chunk_id": "3af2ebbe1cec0003:part:001"
        }
      ]
    }
