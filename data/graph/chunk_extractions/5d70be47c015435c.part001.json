      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "a multi-step thermomechanical process is employed to regulate discontinuous dynamic recrystallization (DDRX) and static recrystallization, achieving an ultrafine-grained microstructure. However, the mechanical properties of high-Cr-bearing alloys are often compromised by brittle Cr-rich precipitates at grain boundaries (GBs), leading to severe embrittlement.",
          "table": null,
          "figure": null,
          "chunk_id": "5d70be47c015435c:part:001"
        }
      ]
    }
