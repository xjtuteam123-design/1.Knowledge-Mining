      ]
    },
    {
      "id": "mechanism_3",
      "name": "dislocation pinning by solute atmosphere",
      "category": "dislocation dynamics",
      "sample_id": "sample_1",
      "material_state": "as-grown single crystal",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "2",
          "section": "3.1.1. Stress–strain curves at various temperatures",
          "quote": "At the intermediate temper- ature, solute atoms segregate near the dislocation core and form a dragging atmosphere around the moving dislocations. As a result of pinning and unpinning effect of dislocations from the atmo- sphere, serration appears.",
