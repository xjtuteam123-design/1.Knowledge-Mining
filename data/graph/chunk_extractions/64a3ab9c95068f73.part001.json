  "process_steps": [
    {
      "id": "process_1",
      "sample_id": "sample_1",
      "sequence": 1,
      "method": "laser powder bed fusion (PBF-LB/M)",
      "parameters": {
        "temperature_c": null,
        "time": null,
        "pressure": null,
        "atmosphere": null,
        "cooling_method": "rapid cooling",
        "deformation": null,
