  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_2",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "Nitrogen atoms induce lattice distortion, hinder dislocation motion, and generate a significant solid solution strengthening effect.",
          "table": null,
          "figure": null,
          "chunk_id": "661d7a7a06309d09:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "dislocation multiplication",
      "category": "deformation",
      "sample_id": "sample_2",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "Oxygen atoms create local chemical order (LCO), seeding more dislocation nucleation sites, promoting dislocation multiplication and ensuring uniform deformation.",
          "table": null,
          "figure": null,
          "chunk_id": "661d7a7a06309d09:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "lattice distortion pinning",
      "category": "strengthening",
      "sample_id": "sample_2",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "4.1. The impact of LCO on deformation behavior",
          "quote": "Lattice distortion pinning effect: The strong lattice distortion induced by solute atoms generates an elastic stress field, hindering the long-range slip of dislocations and leading to an increased dislocation storage density.",
          "table": null,
          "figure": null,
          "chunk_id": "661d7a7a06309d09:part:001"
        }
      ]
    }
