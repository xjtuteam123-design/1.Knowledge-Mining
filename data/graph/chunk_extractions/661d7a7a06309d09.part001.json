      "evidence": [
        {
          "page": 2,
          "section": "2.1. Material processing",
          "quote": "Button-shaped ingots of NO-0 and NO-2 alloys were prepared via vacuum arc melting using pure metals, Ti, Zr, Hf, Nb (purity > 99.95 wt. %), TiO2 and TiN metallic powders with high purity (99.99 wt. %) and particle sizes ≤ 5 μm in a water-cooled copper mold. The samples were melted under an argon atmosphere. Titanium ingots were melted to remove any residual oxygen in the chamber. Each ingot was remelted and inverted at least five times to ensure chemical consistency.",
          "table": null,
          "figure": null,
          "chunk_id": "661d7a7a06309d09:part:001"
        }
      ]
    }
