      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "Results and Discussion",
          "quote": "Since the broadening is caused by the creep deformation with burgers vector of 1/2<101>, the directional broadening is explained by the fact that the crystallographic rotation axis caused by 1/2<101> creep dislocations is <110>",
