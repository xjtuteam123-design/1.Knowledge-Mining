  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "outward diffusion of Cr ions and inward diffusion of oxygen ions",
      "category": "diffusion",
      "sample_id": "sample_1",
      "material_state": "oxidized",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "Results and Discussions",
          "quote": "The mechanism of the outward growth of chromium oxide layer on the surface is the outward diffusion of Cr ions from the alloy to the surface and the inward diffusion of oxygen ions as anionic vacancies at a much lower rate.",
          "table": null,
          "figure": null,
          "chunk_id": "5484680595db3003:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
