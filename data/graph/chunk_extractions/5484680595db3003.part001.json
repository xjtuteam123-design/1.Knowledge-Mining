      "evidence": [
        {
          "page": 3,
          "section": "Results and Discussions",
          "quote": "The lowest negative value of Gibbs free energy26 for the formation of oxides among alloying elements and the low concentration of aluminum enable the preferential internal oxidation of Al.",
          "table": null,
          "figure": null,
          "chunk_id": "5484680595db3003:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
