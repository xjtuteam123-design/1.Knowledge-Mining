          "chunk_id": "e19163a42bf8edd4:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "solid solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_3",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "18",
          "section": "IV. DISCUSSION",
          "quote": "Higher compressive strength of the Nb–12Si–5Mo–20Ti alloy than that recorded for the Nb–12Si–5Mo alloy, despite having lower amounts of lamellar eutectic (Table III) can be attributed not only to the presence of relatively higher fraction of 5-3 silicides ( ~ 2.2 pct as shown in Table III), but also the solid solution strengthening of the primary Nb ss by greater concentration (diﬀerence of ~ 1.8 pct) of Mo present in it",
          "table": null,
          "figure": null,
          "chunk_id": "e19163a42bf8edd4:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "dynamic recovery",
      "category": "softening",
      "sample_id": "sample_2",
      "material_state": "deformed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "14",
          "section": "III. RESULTS",
