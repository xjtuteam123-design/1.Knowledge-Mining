      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "6",
          "section": "III. RESULTS",
          "quote": "the increase in the size of the primary dendritic Nbss phase observed after annealing has enhanced the frequency of bridging of the crack during its propagation.",
