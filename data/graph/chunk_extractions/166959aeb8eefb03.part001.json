        "other": {
          "stirring_speed": "460 rpm",
          "orifice_diameter": "10 mm",
          "gas_flow_rate": "25 lpm"
        }
      },
      "input_state": "AZ31 sections with Al2O3 nanoparticles",
      "output_state": "as-deposited ingot",
      "evidence": [
        {
          "page": 2,
          "section": "2.2 Primary processing",
          "quote": "This involved heating AZ31 sections to 750 1C in an inert Ar gas atmosphere in a graphite crucible using a resistance heating furnace. The crucible was equipped with an arrangement for bottom pouring. Upon reaching the superheat temperature, the molten slurry was stirred for 2.5 min at 460 rpm using a twin blade (pitch 45 1) mild steel impeller to facilitate the uniform distribution of heat.",
          "table": null,
          "figure": null,
          "chunk_id": "166959aeb8eefb03:part:001"
        }
      ]
    },
    {
      "id": "process_2",
      "sample_id": "sample_2",
      "sequence": 2,
      "method": "hot extrusion",
      "parameters": {
        "temperature_c": 350,
        "time": null,
        "pressure": null,
        "atmosphere": null,
        "cooling_method": null,
        "deformation": "extrusion ratio 20.25:1",
        "strain_rate": null,
        "laser_power_w": null,
        "scan_speed": null,
        "layer_thickness": null,
        "other": {
          "preheat_temperature": "400°C",
          "preheat_time": "60 min",
          "lubricant": "colloidal graphite"
        }
      },
      "input_state": "as-deposited ingot",
      "output_state": "extruded rod",
      "evidence": [
        {
          "page": 2,
          "section": "2.3 Secondary processing",
          "quote": "All billets were machined to 35 mm diameter and hot extruded using 20.25:1 extrusion ratio on a 150 t hydraulic press. The extrusion temperature was 350 1C. The billets were held at 400 1C for 60 min in a furnace prior to extrusion. Colloidal graphite was used as a lubricant. Rods of 8 mm were obtained.",
          "table": null,
          "figure": null,
          "chunk_id": "166959aeb8eefb03:part:001"
        }
      ]
    }
