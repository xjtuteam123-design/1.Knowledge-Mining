  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "oxygen diffusion slowed by Nb doping",
      "category": "diffusion",
      "sample_id": "sample_5",
      "material_state": "oxidized at 1273 K for 50 h",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "3.3. Scale morphology and cross-sectional observations",
          "quote": "When TiO2 is doped with niobium, Nb5+ ions replace Ti4+ ions, which leads to a net decrease of oxygen vacancies and, therefore, oxygen diffusion is slowed.",
