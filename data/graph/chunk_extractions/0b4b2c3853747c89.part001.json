  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "adhesive failure",
      "category": "fracture mechanism",
      "sample_id": "sample_1",
      "material_state": "as-joined",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3. Results and discussion",
          "quote": "most of the HEC reaction interlayers and C/C composites remained intact after the fracture, thereby suggesting that the fracture predominantly took place at the C/C-filler interface via an adhesive failure mode.",
          "table": null,
          "figure": null,
          "chunk_id": "0b4b2c3853747c89:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "cohesive failure",
      "category": "fracture mechanism",
      "sample_id": "sample_2",
      "material_state": "as-joined",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3. Results and discussion",
          "quote": "the observation of fractured carbon fibers on the surfaces of the formed HEC interlayers in both perpendicular and parallel directions to the joining interfaces, as demonstrated in Fig. 4 (d) and (e), indicates that a portion of the fracture occurred within the C/C composite adjacent to the C/C-HEC interface through a cohesive failure mode.",
          "table": null,
          "figure": "Fig. 4",
          "chunk_id": "0b4b2c3853747c89:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "residual stress due to CTE mismatch",
      "category": "stress mechanism",
      "sample_id": "sample_1",
      "material_state": "as-joined",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3. Results and discussion",
          "quote": "This outcome can be attributed to the high residual stress caused by the mismatch of the coefficients of thermal expansion (CTE) between the C/C composite and formed HECs due to the extremely rapid cooling rate during the flash SPS process.",
          "table": null,
          "figure": null,
          "chunk_id": "0b4b2c3853747c89:part:001"
        }
      ]
    }
