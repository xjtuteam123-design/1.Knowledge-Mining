      "evidence": [
        {
          "page": 2,
          "section": "Materials and methods",
          "quote": "The first batch of CrCoNi alloy samples was printed by a customized LPBF machine equipped with a 200 W SPI fiber laser source, as schematically shown in Fig. 1a. In contrast with the continuous-wave lasers used in typical LPBF processes, the laser in this work was emitted in repeated pulses at a frequency of 1000 kHz (Fig. 1b). The working duration of each pulse was ∼250 ns. The wavelength and the spot size of the laser were 1060 nm and 100 lm respectively.",
          "table": null,
          "figure": "1a, 1b",
          "chunk_id": "d2a6fd30b5e1dbdf:part:001"
        }
      ]
    },
    {
      "id": "process_2",
      "sample_id": "sample_2",
