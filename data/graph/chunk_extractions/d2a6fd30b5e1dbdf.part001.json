      "parameters": {
        "temperature_c": null,
        "time": null,
        "pressure": null,
        "atmosphere": null,
        "cooling_method": null,
        "deformation": null,
        "strain_rate": null,
        "laser_power_w": 200,
        "scan_speed": "500 mm/s",
        "layer_thickness": "40 μm",
        "other": {
          "laser_type": "continuous-wave",
          "wavelength": "1060 nm",
          "spot_size": "100 μm",
          "hatch_spacing": "80 μm",
          "scan_rotation": "90°"
        }
      },
      "input_state": "powder",
      "output_state": "as-built",
      "evidence": [
        {
          "page": 2,
          "section": "Materials and methods",
          "quote": "To compare the effect of continuous-wave and pulsed-wave lasers on microstructure and mechanical properties, a second batch of CrCoNi samples was printed with the same geometric size using a commercial LPBF machine (EOS M290). The continuous-wave laser used in this batch had the same wavelength (1060 nm) and spot size (100 lm) as the pulsed-wave laser used in the first batch. To decouple the influence of other factors, the print parameters were selected from the process window optimized in the first batch print: a laser power of 200 W, a scanning speed of 500 mm/s, a hatch spacing of 80 lm, a layer thickness of 40 lm, and a scan rotation of 90°.",
          "table": null,
          "figure": null,
          "chunk_id": "d2a6fd30b5e1dbdf:part:001"
        }
      ]
    },
