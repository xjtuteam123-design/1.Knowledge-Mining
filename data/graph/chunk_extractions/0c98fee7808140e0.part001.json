  "paper_metadata": {
    "document_type": "literature",
    "title": "Comparison of the microstructural and wear resistance for thermal spray coating deposited oxidation and wear resistant AlSiTiCrFeCoNiMo and AlSiTiCrFeNiMo",
    "authors": [
