  "alloy_systems": [
    {
      "id": "alloy_system_1",
      "name": "Al-Si-Ti-Cr-Fe-Co-Ni-Mo high-entropy alloy",
      "material_category": "high-entropy alloy",
      "evidence": [
        {
          "page": "1",
          "section": null,
          "quote": "The thermal spray technology is commonly used for structural components by building up a protective coating layer on their surfaces. Choos ing a suitable sprayed metal can improve corrosion resistance, [1,2] oxidation resistance, [3–5] wear resistance[6] and/or heat insulation, and thus extend the life of protected components.",
          "table": null,
          "figure": null,
          "chunk_id": "0c98fee7808140e0:part:001"
        },
        {
          "page": "1",
          "section": null,
          "quote": "In this study, a new alloy design concept was explored to create alloys with excellent combinations of properties for some critical applications such as dies, molds and turbine blades.",
          "table": null,
          "figure": null,
          "chunk_id": "0c98fee7808140e0:part:001"
        }
      ]
    },
