        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "dislocation aggregation",
      "category": "deformation",
      "sample_id": "sample_3",
      "material_state": "continuous pack rolled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "3.2 Microstructure of the rolled sheets",
          "quote": "The region with larger deformation will produce stress concentration, causing dislocations to gather in local stress concentration region, forming dislocation entanglement.",
          "table": null,
          "figure": "Fig. 6",
          "chunk_id": "912327381d4014eb:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "atomic diffusion",
      "category": "kinetics",
      "sample_id": "sample_3",
      "material_state": "continuous pack rolled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "3.2 Microstructure of the rolled sheets",
          "quote": "According to classical kinetic theory of atomic diffusion [46], this can be attributed to the greater atomic activity near the dislocation aggregation region, where is easily diffused.",
          "table": null,
          "figure": null,
          "chunk_id": "912327381d4014eb:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "<111>{110} slip",
      "category": "plastic deformation",
      "sample_id": "sample_3",
      "material_state": "continuous pack rolled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "9",
          "section": "3.4 Mechanical properties of the rolled sheets",
          "quote": "the rolled sheets have obvious selective orientations on the {110} crystal planes, and the orientations on the {110} crystal planes are mainly concentrated in TD, which forms a strong <111>{110} texture. Therefore, the sheet is prone to activate <111>{110} slip along TD and has better plasticity.",
          "table": null,
          "figure": "Fig. 10c",
