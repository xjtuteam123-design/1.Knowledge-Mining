  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "doping effect",
      "category": "oxidation",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "Introduction",
          "quote": "Its positive effect is generally explained in terms of the doping effect and increase of aluminum activity and diffusivity. The doping effect refers to a reduction of O vacancy concentration in rutile lattice which are responsible for oxygen diffusion, due to the higher valency of Nb than of Ti.",
          "table": null,
          "figure": null,
          "chunk_id": "d8ee724eb9957006:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
