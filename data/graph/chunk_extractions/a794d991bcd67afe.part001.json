        "location": null,
        "composition": "Fe 67.9, Al 23.3, Ti 8.8 at.%",
        "identification_status": "experimental"
      },
      "evidence": [
        {
          "page": 2,
          "section": "III. RESULTS AND DISCUSSION",
          "quote": "Figure 1 shows the microstructures of alloy Fe-23Al-8.5Ti [Fig. 1(a)] in the as-cast state and [Fig. 1(b)] after heat treatment at 1000 °C/500 h. In both cases the micrographs show a microstructure that resembles that of the g/g0 microstructure of the Ni-base super alloys. While the cuboidal precipitates are in the range of 10 nm in the as-cast condition, they coarsened to about 1 mm after heat treatment.",
          "table": null,
          "figure": "Fig. 1",
          "chunk_id": "a794d991bcd67afe:part:001"
        }
      ]
    },
