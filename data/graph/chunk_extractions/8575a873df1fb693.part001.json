          "figure": "Fig. S1",
          "chunk_id": "8575a873df1fb693:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "activation of non-basal <a> and <c> dislocations accommodating c-axis plasticity",
      "category": "plastic deformation",
      "sample_id": "sample_1",
      "material_state": "deformed in tension at 300 °C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3. Results and discussion",
          "quote": "the germination of <c> dislocations in the WZA631 alloy under extensive strain sustains the c-axis plastic pace that supports the fulfillment of the von Mises criteria for extensive plasticity (Fig. 2), thus avoiding the occurrence of macro-plastic instability",
          "table": null,
          "figure": "Fig. 2",
          "chunk_id": "8575a873df1fb693:part:001"
        }
      ]
