  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "geometric confinement of LPSO cellular shell to grain boundaries and dislocations",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "1",
          "section": "Abstract",
          "quote": "Such remarkable strength ascribes to the strong geometric confinement of the LPSO cellular shell to grain boundaries and dislocations, coupled with extra strain hardening derived from <a> dislocation interactions with stacking faults.",
          "table": null,
          "figure": null,
          "chunk_id": "8575a873df1fb693:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "strain hardening from <a> dislocation interactions with stacking faults",
      "category": "strain hardening",
      "sample_id": "sample_1",
      "material_state": "deformed in tension at 300 °C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "2",
          "section": "3. Results and discussion",
          "quote": "The interactions between <a> dislocations and SFs produce an extra anchoring force in the dislocation-active region, aiding in persistent strain-hardening and high strength.",
          "table": null,
          "figure": "Fig. 2",
          "chunk_id": "8575a873df1fb693:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "grain boundary pinning by LPSO honeycomb shell against grain coarsening",
      "category": "microstructural stabilization",
      "sample_id": "sample_1",
      "material_state": "deformed in tension at 300 °C",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": "2",
          "section": "3. Results and discussion",
          "quote": "the honeycomb shell crafted by the LPSO phase may be presumed to be the formidable obstacle against grain coarsening, inducing a minimal variation in the grain size from 5.1 μm to 7.1 μm",
