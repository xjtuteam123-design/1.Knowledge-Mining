      "evidence": [
        {
          "page": 7,
          "section": "Results and Discussion",
          "quote": "Simultaneously, the size of the gamma' phase increases, indicating the diffusion of alloying elements during the heat treatment process, in agreement with the simplified Lifshitz-Slyozof-Wagner theory (R^3_t - R^3_0 = Kt, where Rt is the radius of the gamma' phase after t hours of heat treatment, R0 is the radius of the initial gamma' phase, K is the Ostwald coarsening rate constant, and t is time for heat treatment).",
          "table": null,
          "figure": null,
          "chunk_id": "5b228f8d9a3370f6:part:001"
        }
      ]
