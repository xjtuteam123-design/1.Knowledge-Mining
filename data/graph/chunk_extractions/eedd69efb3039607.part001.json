  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "incoherent γ′ phase does not contribute to strengthening",
      "category": "strengthening",
      "sample_id": "sample_3",
      "material_state": "MH processed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 2,
          "section": "Introduction",
          "quote": "However, we noticed that the γ′ phase precipitated on the grain boundaries of the γ phase during hot forging at temperatures below that of the γ′ phase solvus does not achieve lattice matching with the γ phase (this type of γ′ phase is de ﬁned as “incoherent γ′ phase”). Therefore the incoherent γ′ phase has no strengthening effect.",
          "table": null,
          "figure": "Fig. 2",
          "chunk_id": "eedd69efb3039607:part:001"
        }
      ]
    },
