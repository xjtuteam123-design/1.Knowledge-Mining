      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 2,
          "section": "New concepts",
          "quote": "The dislocations are jammed up and are forced to take alternative pathways via massive cross-slip, forming wavy dislocation walls that inevitably entangle with other slip bands.",
