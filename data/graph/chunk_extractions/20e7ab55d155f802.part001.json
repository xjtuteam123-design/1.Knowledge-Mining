  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "Kolbe micro-twinning mechanism",
      "category": "deformation mechanism",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "Introduction",
          "quote": "The Kolbe mechanism (see schematic diagrams in Refs. [ 1 , 7 , 13 ]) for micro-twinning, based on therm ally activated reordering, is currently widely accepted in the sci - entific community to explain these processes [ 13-15 ]. In this mecha - nism, 1/6 〈 112 〉 partial dislocations shear the precipitates, moving in a correlated manner, as dislocation pairs on adjacent {111} glide planes.",
          "table": null,
          "figure": null,
          "chunk_id": "20e7ab55d155f802:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "vacancy mediated reordering",
      "category": "diffusion mechanism",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 2,
          "section": "Methods",
          "quote": "The high energy double CSF reorders into a superlattice extrinsic stacking fault (SESF) via vacancy mediated thermally activated diffu - sion, as originally proposed by Kolbe [ 7 , 19 ].",
          "table": null,
          "figure": null,
          "chunk_id": "20e7ab55d155f802:part:001"
        }
      ]
    }
