  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "original primary dendrite orientation deviation",
      "category": "solidification defect formation",
      "sample_id": "sample_1",
      "material_state": "as-cast, withdrawal rate 60 um/s",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "III. RESULTS AND DISCUSSIONS",
          "quote": "the angles of LABs were close to the deviation angles between L and R. In other words, the LABs were mainly caused by the fluctuations of the original orientation of PDA-L and PDA-R.",
          "table": "Table I",
          "figure": null,
          "chunk_id": "12db34076e5c4cdc:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "nonuniform thermal field and solid-liquid interface curvature fluctuation",
      "category": "solidification",
      "sample_id": "sample_1",
      "material_state": "as-cast, withdrawal rate 60 um/s",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": "3",
          "section": "III. RESULTS AND DISCUSSIONS",
          "quote": "the random orientation fluctuations might be natural in the growth of a single crystal because the complex geometry might lead to a nonuniform thermal field and the curvature fluctuation of solid–liquid interface, especially in region SE",
          "table": null,
          "figure": "Fig. 4",
          "chunk_id": "12db34076e5c4cdc:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "dendrite deformation under contraction stress",
      "category": "solidification defect formation",
      "sample_id": "sample_1",
      "material_state": "as-cast, withdrawal rate 75 um/s",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "5",
          "section": "III. RESULTS AND DISCUSSIONS",
          "quote": "region SE was a stress concentration area and was beneficial to dendrite deformation in this region. Besides, the long secondary branches in region SE could be regarded as some cantilever beams, and they were relatively fragile at the mushy stage and were prone to deformation due to contraction stress.",
          "table": null,
          "figure": "Fig. 6",
          "chunk_id": "12db34076e5c4cdc:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "lateral heat extraction",
      "category": "solidification",
      "sample_id": "sample_1",
      "material_state": "as-cast, withdrawal rate 100 um/s",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "6",
          "section": "III. RESULTS AND DISCUSSIONS",
          "quote": "It might be caused by the substantial lateral heat extraction in this region. Figure 8(a) shows the isotherm shapes at the beginning of solidification in region M. Obviously, the isotherm shape was concave and looks like an ellipsoidal surface, and it was propitious for lateral heat dissipation.",
          "table": null,
          "figure": "Fig. 8(a)",
          "chunk_id": "12db34076e5c4cdc:part:001"
        }
      ]
    }
  ],
