  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid solution strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 8,
          "section": "Discussion",
          "quote": "We attribute this to the enhanced solid solution strengthening by further addition of Mo content in the Mo7.5 alloy. Mo has the largest metallic radius among the five elements in the present alloy system, and it is known that the increase in the Mo content in the fcc phase leads to the enhanced solid solution strengthening effect",
          "table": null,
          "figure": null,
          "chunk_id": "fa667d14756cf540:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "precipitation strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 8,
          "section": "Discussion",
          "quote": "The hardness of the μ-phase particles is extremely high in the order of 15 GPa. These hard particles precipitated at boundaries and those in the ductile fcc matrix are not plastically sheared by gliding dislocation during plastic deformation. Thus, they act as a strong barrier for dislocation motion, leading to the precipitation strengthening.",
          "table": null,
          "figure": null,
          "chunk_id": "fa667d14756cf540:part:002"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "grain boundary strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 8,
          "section": "Discussion",
          "quote": "In addition, grain-refinement with decreasing annealing temperature also enhances the strength of the material.",
          "table": null,
          "figure": null,
          "chunk_id": "fa667d14756cf540:part:002"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "dislocation strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 8,
          "section": "Discussion",
          "quote": "multiple strengthening mechanisms including solid solution strengthening, precipitation strengthening, GB strengthening, and dislocation strengthening, are responsible for the increase in the strength of the Mo7.5 alloy specimen annealed at 900 °C",
          "table": null,
          "figure": null,
          "chunk_id": "fa667d14756cf540:part:002"
        }
      ]
    },
    {
      "id": "mechanism_5",
