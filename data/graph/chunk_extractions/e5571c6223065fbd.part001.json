  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "twin boundary strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "as-drawn",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "2",
          "section": "Results and discussion",
          "quote": "The formation of the high density of TBs greatly reduced the actual grain size. According to the Hall-Petch relation, resulting grain refinement is to a great extent responsible for enhanced yield strength of the alloy.",
