  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "precipitation hardening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 12,
          "section": "3. Results and Discussion",
          "quote": "Increased creep resistance at high temperatures is achieved in Ni-based superalloys by precipitation hardening (PH). Precipitation hardening of Ni-based superalloys is provided by elements such as Al, Ti, and Nb.",
          "table": null,
          "figure": null,
          "chunk_id": "68b93cca96aa903a:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "solid-solution strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 11,
          "section": "3. Results and Discussion",
          "quote": "Superalloys are strengthened through three principal mechanisms: (a) solid-solution hardening (SSH); (b) precipitation hardening (PH); and (c) oxide-dispersion strengthening (ODS).",
          "table": null,
          "figure": null,
          "chunk_id": "68b93cca96aa903a:part:002"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "dislocation bypass",
      "category": "deformation",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 16,
          "section": "3. Results and Discussion",
          "quote": "However, this effect is limited by the so-called Orowan′s dislocation propagation mechanism [55], where a significant coarsening of the precipitate γ′ forms wider channels between them and thus dislocations can be propagated by bypassing the coarse precipitates and reducing the effect of precipitation hardening [52].",
          "table": null,
          "figure": null,
          "chunk_id": "68b93cca96aa903a:part:002"
