  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dynamic recovery and dynamic recrystallization (DDRX)",
      "category": "dynamic recrystallization",
      "sample_id": "sample_3",
      "material_state": "hot-rolled at 800 °C and air-cooled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "12",
          "section": "4.2",
          "quote": "the cumulative misorientation for all three groups of 800-AC specimens was less than 15 °, with a maximum cumulative misorientation of about 9 °. This indicates that the DDRX process mainly occurs during hot rolling at 800 °C.",
          "table": null,
          "figure": "14",
          "chunk_id": "00f6df189b4d1180:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "continuous dynamic recrystallization (CDRX)",
      "category": "dynamic recrystallization",
      "sample_id": "sample_4",
      "material_state": "hot-rolled at 750 °C and air-cooled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "12",
          "section": "4.2",
          "quote": "This suggests that hot rolling at 750 °C enhances the sub-grain’s activity, making them more prone to absorbing dislocations and producing recrystallized grains by merging or rotation. As the rolling temperature decreases, the dynamic recrystallization mechanism gradually shifts from DDRX to CDRX.",
          "table": null,
          "figure": "14",
          "chunk_id": "00f6df189b4d1180:part:002"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "grain boundary strengthening",
      "category": "strengthening",
      "sample_id": "sample_4",
      "material_state": "hot-rolled at 750 °C and air-cooled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "13",
          "section": "4.3",
          "quote": "In terms of yield strength, grain boundary strengthening can be classiﬁed into ﬁne-grain strengthening and sub-grain strengthening. Both types of strengthening are consistent with the Hall-Petch theory.",
          "table": null,
          "figure": null,
          "chunk_id": "00f6df189b4d1180:part:002"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "dislocation strengthening",
      "category": "strengthening",
      "sample_id": "sample_4",
      "material_state": "hot-rolled at 750 °C and air-cooled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "14",
          "section": "4.3",
          "quote": "The introduction of dislocation density increases the resistance of the alloy to plastic deformation and thus strengthened the yield strength.",
          "table": null,
          "figure": null,
          "chunk_id": "00f6df189b4d1180:part:002"
        }
      ]
