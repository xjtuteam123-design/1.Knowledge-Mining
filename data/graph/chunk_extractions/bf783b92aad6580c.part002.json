  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "low-temperature cooling improving surface finish",
      "category": "surface quality effect",
      "sample_id": "sample_1",
      "material_state": "machined at -120 °C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "9",
          "section": null,
          "quote": "The local low-temperature environment can enhance the material’s brittleness, weaken the plastic deformation capacity of the processed surface, thereby reducing the surface roughness. The smoother the machining surface, the fewer indentations, the more evenly distributed the stress, thus less likely to crack or similar phenomena, prolonging the usage time, enhancing fatigue resistance, and thereby improving fatigue strength.",
          "table": null,
          "figure": null,
          "chunk_id": "bf783b92aad6580c:part:002"
        }
      ]
    }
