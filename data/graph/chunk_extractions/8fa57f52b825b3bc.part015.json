    {
      "id": "alloy_system_4",
      "name": "maraging steel",
      "material_category": "ultrahigh strength steel",
      "evidence": [
        {
          "page": 205,
          "section": "8.3 Maraging Steels",
          "quote": "The maraging steels are a group of interstitial-free Ni –Co–Mo–Ti high alloy steels. Maraging steels belong to a class of ultrahigh strength steels where the strengthening mechanism is different from the classical mechanism associated with carbon martensite, bainite or precipitation of carbides during tempering.",
          "table": null,
          "figure": null,
          "chunk_id": "8fa57f52b825b3bc:part:015"
        }
      ]
    },
    {
      "id": "alloy_system_5",
      "name": "precipitation hardening stainless steel",
      "material_category": "stainless steel",
      "evidence": [
        {
          "page": 209,
          "section": "8.4 Precipitation Hardening (PH) Steels",
          "quote": "Precipitation hardening (PH) stainless steels are a family of corrosion resistant alloys that achieve high strengths from the precipitation of alloy carbides and solid solution strengthening. These steels contain a minimum of 12 wt% chromium to obtain stainless properties.",
          "table": null,
          "figure": null,
          "chunk_id": "8fa57f52b825b3bc:part:015"
        }
      ]
