  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dislocation bypass",
      "category": "strengthening mechanism",
      "sample_id": "sample_2",
      "material_state": "overaged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": null,
          "quote": "dislocation bypass mechanism with the increase of the grain size of the precipitated phase. As the grain size of the overaged specimen increases, the strong coupling dislocation bypassing mechanism plays a dominant role",
          "table": null,
          "figure": null,
          "chunk_id": "a297d7212efb2eb1:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "elemental segregation",
      "category": "defect formation",
      "sample_id": "sample_1",
      "material_state": "solutionized, tested at 925 °C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": null,
          "quote": "A closer look at the MC-type carbides shows elemental segregation within the carbides, with the black line being the elementally enriched region, which is often the nucleation-site for defects and crack initiation.",
          "table": null,
          "figure": "13",
          "chunk_id": "a297d7212efb2eb1:part:002"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "crack initiation",
      "category": "failure mechanism",
      "sample_id": "sample_1",
      "material_state": "solutionized, tested at 925 °C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": null,
          "quote": "which is often the nucleation-site for defects and crack initiation. Previous literature found that cracks frequently sprout around the carbide.",
          "table": null,
          "figure": "13",
          "chunk_id": "a297d7212efb2eb1:part:002"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "grain boundary strengthening",
      "category": "strengthening mechanism",
      "sample_id": "sample_2",
      "material_state": "overaged, tested at 925 °C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": null,
          "quote": "The presence of M26C6 at the grain boundaries indicates that the decomposition of MC carbides to M26C6 occurs in the aged alloy, which strengthens the grain boundaries and reduces the susceptibility of the alloy to intergranular cracking.",
          "table": null,
          "figure": null,
          "chunk_id": "a297d7212efb2eb1:part:002"
        }
      ]
    },
    {
      "id": "mechanism_5",
      "name": "eutectic liquefaction",
      "category": "phase transformation",
      "sample_id": "sample_2",
      "material_state": "overaged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "11",
          "section": "Conclusion",
          "quote": "The γ ′ phase near the grain boundary is mainly dissolved by eutectic liquefaction, while the γ ′ phase inside the grain is dissolved by local dissolution.",
