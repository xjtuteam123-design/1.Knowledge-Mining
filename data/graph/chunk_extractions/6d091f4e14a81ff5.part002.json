  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "elastic repulsive interaction",
      "category": "elastic interaction",
      "sample_id": "sample_5",
      "material_state": "phase-field simulated at 950 °C for 2 h with ΔC'=0%",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "8",
          "section": "3. 2D analysis",
          "quote": "This implies that the elastic interaction between two neighboring precipitates is most of the time repulsive. As observed in Fig. 8 , this repulsive force, given by the slope of the interaction energy curve, increases as DC0 increases.",
          "table": null,
          "figure": "Fig. 8",
          "chunk_id": "6d091f4e14a81ff5:part:002"
        }
      ]
    },
