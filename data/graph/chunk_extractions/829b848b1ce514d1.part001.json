  "phases_and_microstructures": [
    {
      "id": "phase_1",
      "type": "Phase",
      "name": "Cr2O3",
      "sample_id": "sample_1",
      "material_state": "as-oxidized",
      "attributes": {
        "phase_fraction": null,
        "size": "thickness between 1 and 2.5 μm after 1 hr; average about 5 μm after 50 hr; varies between 1 and 12 μm after 200 hr",
        "morphology": "knot-shaped particles",
        "location": "surface",
        "composition": null,
        "identification_status": "experimental"
      },
      "evidence": [
        {
          "page": "3",
          "section": "EXPERIMENTAL RESULTS",
          "quote": "After heating to 1150°C the surface of MA754 is partially covered by relatively small knot-shaped CrzO3 particles (Fig. 2a and Fig. 2b; 1: knots of chromia) which are aligned along the stripes left back from polishing. XRD indeed showed nickel and small chromia peaks (Fig. 2a').",
          "table": null,
          "figure": "2a, 2b, 2a'",
          "chunk_id": "829b848b1ce514d1:part:001"
        },
        {
          "page": "4",
          "section": "EXPERIMENTAL RESULTS",
          "quote": "After one hour at 1150°C the weight of MA754 has moderately increased. Its surface is now completely covered with Cr203 knots which have also increased in size (Fig. 2c; 1 : chromia knot scale). The thickness of the chromia layer is between 1 and 2.5/.tin (Fig. 2d).",
          "table": null,
