          "figure": null,
          "chunk_id": "58d863414f9befb2:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_3",
      "name": "Nb-Si binary alloy",
      "material_category": "refractory alloy",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "For the Nb-10W alloy, the microstructure was a monolithic Nb solid solution (Nbss) with a grain size up to a few hundred microns, while the other four alloys consisted of primary Nbss and a eutectic of Nbss/Nb5Si3 (5-3 silicide) as a result of replacing Nb with Si.",
          "table": null,
          "figure": null,
          "chunk_id": "58d863414f9befb2:part:001"
        }
      ]
    }
