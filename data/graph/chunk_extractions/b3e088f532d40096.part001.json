      "evidence": [
        {
          "page": "7",
          "section": "5. Conclusions",
          "quote": "NbAlV is a single B2 phase. 5 at.% Hf addition is completely dissolved into the matrix. 5 at.% Hf and TiC addition led to the formation of MC-type carbides: irregularly shaped primary and needle shaped secondary.",
          "table": null,
          "figure": null,
          "chunk_id": "b3e088f532d40096:part:001"
        },
        {
          "page": "6",
          "section": "4. Discussion",
          "quote": "The NbAlVHfTiC alloy, having a high volume fraction of carbide (0.072) and large carbides (5.2 /H9262m), could be regarded as a carbide-reinforced composite.",
          "table": null,
          "figure": null,
          "chunk_id": "b3e088f532d40096:part:001"
        }
      ]
