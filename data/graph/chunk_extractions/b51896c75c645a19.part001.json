  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid solution strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 3,
          "section": "Solid solution strengthening",
          "quote": "Since the atomic radius of each added element differs to that of the major element – Ni, the crystal lattice is distorted around the substitutional solute atom. The resulting strain field interacts elastically with that of a dislocation, thereby impeding the motion of dislocations and increasing the strength relative to a pure Ni matrix.",
          "table": null,
          "figure": null,
          "chunk_id": "b51896c75c645a19:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "precipitation strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 4,
          "section": "Precipitation strengthening",
          "quote": "It is generally accepted that the amount of strengthening due to the addition of precipitates increases with the volume fraction ofγ ′particles [6].",
          "table": null,
          "figure": null,
          "chunk_id": "b51896c75c645a19:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "coherency strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 3,
          "section": "Mechanisms of strengthening",
          "quote": "Coherency strengthening occurs when the lattice parameters of the matrix and coherent precipitate phase differ, therefore causing a strain field to be set up surrounding the precipitate.",
          "table": null,
          "figure": null,
          "chunk_id": "b51896c75c645a19:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "grain boundary strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 6,
          "section": "Grain boundary strengthening",
          "quote": "The motion of dislocations is impeded by the presence of these boundaries, therefore when present, larger stresses are required to cause plastic deformation of the material [7].",
          "table": null,
          "figure": null,
          "chunk_id": "b51896c75c645a19:part:001"
        }
      ]
    },
    {
      "id": "mechanism_5",
      "name": "order strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 3,
          "section": "Mechanisms of strengthening",
          "quote": "Finally, order strengthening occurs when the precipitates have an ordered crystal structure, which is disrupted by a dislocation travelling through the precipitate, thereby creating an anti-phase boundary with associated energy (APBE).",
          "table": null,
          "figure": null,
          "chunk_id": "b51896c75c645a19:part:001"
        }
      ]
    },
    {
      "id": "mechanism_6",
      "name": "weak pair coupling",
      "category": "deformation mechanism",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 4,
          "section": "Precipitation strengthening",
          "quote": "For small precipitates, which are more easily cut by dislocations, each dislocation of the pair is located within a different precipitate. This arrangement is termed weak pair coupling (Figure5(a)).",
          "table": null,
          "figure": "Figure 5",
          "chunk_id": "b51896c75c645a19:part:001"
        }
      ]
    },
    {
      "id": "mechanism_7",
      "name": "strong pair coupling",
      "category": "deformation mechanism",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 4,
          "section": "Precipitation strengthening",
          "quote": "In contrast, in larger precipitates both dislocations in the pair are held closer together by the large APBE, and are found within the same precipitate (strong pair coupling)(Figure 5(b)).",
          "table": null,
          "figure": "Figure 5",
          "chunk_id": "b51896c75c645a19:part:001"
        }
      ]
    },
    {
      "id": "mechanism_8",
      "name": "Orowan looping",
      "category": "deformation mechanism",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 4,
          "section": "Precipitation strengthening",
          "quote": "In overaged alloys, the precipitates are yet larger, and deformation occurs not by cutting but by dislocations looping around the precipitates via Orowan looping [4,24].",
          "table": null,
          "figure": null,
          "chunk_id": "b51896c75c645a19:part:001"
        }
      ]
    }
