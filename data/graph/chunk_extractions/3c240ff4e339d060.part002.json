      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 14,
          "section": "5. Conclusions",
          "quote": "Such superior mechanical performance originates from dual-scale chemical fluctuations (M-CFs and L-CFs), which induce heterogeneous local environments that govern dislocation behavior.",
