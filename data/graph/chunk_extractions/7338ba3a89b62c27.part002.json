  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "self-healing by directional Ti diffusion and eta-Ni3Ti precipitation at cavities",
      "category": "diffusion",
      "sample_id": "sample_1",
      "material_state": "creep-tested",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "8",
          "section": "Results",
          "quote": "during the creep, the solid solutioned Ti atoms are driven to move toward the cavity surfaces by the chemical driving force, and herein nucleate as η-Ni3Ti healing precipitates. This directional diffusion will interrupt the transmission of vacancies towards the cavities",
          "table": null,
          "figure": "7",
          "chunk_id": "7338ba3a89b62c27:part:002"
        }
      ]
    },
    {
