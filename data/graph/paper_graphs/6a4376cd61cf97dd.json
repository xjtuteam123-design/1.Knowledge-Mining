  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "constitutional undercooling",
      "category": "solidification",
      "sample_id": "sample_3",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "Page 6",
          "section": "4 Discussion",
          "quote": "As a result, the formation mechanism of fine cellular grains could be summarized to constitutional undercooling. When the solid solution alloy was solidified under a positive temperature gradient, the melt temperature at the front of the solid-liquid interface would lower than the actual liquidus temperature. Accompany with the increase of constitutional undercooling, the interface shape would gradually develop from straight interface to cell and finally to dendrite.",
          "table": null,
          "figure": null,
          "chunk_id": "6a4376cd61cf97dd:part:001"
        }
      ]
    },
