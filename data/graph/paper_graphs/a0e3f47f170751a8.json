      "input_state": "powder",
      "output_state": "as-sprayed",
      "evidence": [
        {
          "page": "2",
          "section": "Experimental procedure",
          "quote": "A 40 kW Miller thermal plasma spray apparatus was used to deposit the coating of NiCrAlY (Praxair NI-343) alloy powder on the given superalloys. Argon was used as the powder carrying and shielding gas. All of the process parameters, including the spray distance, were constant throughout coating process. The parameters included an arc current of 700 A, arc voltage of 35 V , powder ﬂow rate of 3.2 rev min2 1, the spraying distance of 90-110 mm, and the plasma arc gas (Argon) and carrier gas (Argon) pressures of 59 and 40 psi, respectively.",
          "table": null,
          "figure": null,
          "chunk_id": "a0e3f47f170751a8:part:001"
        }
      ]
