  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dynamic embrittlement",
      "category": "environmental degradation",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 2,
          "section": "Introduction",
          "quote": "The interaction of oxygen with metallic alloys such as iron-, nickel- and cobalt-based superalloys at elevated temperatures can lead to two closely related environmental degradation mechanisms, which have been coined as: (1) oxygen or dynamic embrittlement, and (2) stress accelerated grain boundary oxidation and fracture of the oxidised grain boundaries.",
          "table": null,
          "figure": null,
          "chunk_id": "afe909a8a4025ec5:part:001"
        }
      ]
    },
    {
