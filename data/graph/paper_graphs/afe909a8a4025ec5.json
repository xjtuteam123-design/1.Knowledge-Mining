      "evidence": [
        {
          "page": "7",
          "section": null,
          "quote": "Stress relaxation at the crack tip reduces the da/dt response because the relaxed stress field is less likely to cause oxide fracture at the crack tip by decreasing the region where the critical stress for oxide fracture can be attained.",
