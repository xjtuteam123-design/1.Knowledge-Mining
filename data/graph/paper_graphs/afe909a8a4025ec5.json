      "evidence": [
        {
          "page": 2,
          "section": "Introduction",
          "quote": "Besides oxidation, time-dependent deformation in Ni-based superalloys can lead to creep crack growth as the consequence of the formation, growth and coalescence of creep cavities along grain boundaries.",
          "table": null,
          "figure": null,
          "chunk_id": "afe909a8a4025ec5:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "transformation toughening",
      "category": "oxidation mitigation",
      "sample_id": null,
