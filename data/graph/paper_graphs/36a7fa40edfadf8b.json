  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "vacancy hardening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "9",
          "section": "Discussion",
          "quote": "The enhanced strength of as-cast alloys is attributed to vacancy hardening, whose effect will be reduced during high temperature deformation.",
          "table": null,
          "figure": null,
          "chunk_id": "36a7fa40edfadf8b:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "solid solution strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "9",
          "section": "Conclusions",
          "quote": "Ru addition generated large lattice distortion and modi \u001c ed the electron-atom ratio when it dissolved into \u0003-TiAl. Thus it contributed to the solid solution strengthening.",
          "table": null,
          "figure": null,
          "chunk_id": "36a7fa40edfadf8b:part:002"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "dynamic recrystallization",
      "category": "microstructural evolution",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": "9",
          "section": "Conclusions",
