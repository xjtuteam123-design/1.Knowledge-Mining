      "material_category": "bulk metallic glass",
      "evidence": [
        {
          "page": 1,
          "section": "Title",
          "quote": "Ni-Nb-P-based bulk glass-forming alloys: Superior material properties combined in one alloy family",
          "table": null,
          "figure": null,
          "chunk_id": "b6079991510fc31f:part:001"
        },
        {
          "page": 5,
          "section": "3.3",
          "quote": "In summary, minor additions of P allow an increase in GFA from 2 mm (0.25 mm) for binary Ni62Nb38 (Ni58.5Nb41.5) up to 5 mm for ternary Ni-Nb-P, which to our knowledge has to date not been reported in the literature for Ni-Nb based alloys.",
          "table": null,
          "figure": null,
          "chunk_id": "b6079991510fc31f:part:002"
        }
      ]
    },
    {
      "id": "alloy_system_2",
      "name": "Ni-Nb-Ta-P alloy",
      "material_category": "bulk metallic glass",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "The partial substitution of Nb by Ta further boosts the glass-forming ability to values 200 % higher than that of the binary base alloy.",
          "table": null,
          "figure": null,
          "chunk_id": "b6079991510fc31f:part:001"
        },
        {
          "page": 5,
          "section": "3.3",
          "quote": "Various thicknesses of Ni59.2Nb38.8-yTayP2 (hereafter Tay, y = 0, 1, 3, 5, … , 38.8) were studied, indicating a rise of the critical casting thickness up to 6 mm over a wide range from 1 to 13 at% Ta",
          "table": null,
          "figure": null,
          "chunk_id": "b6079991510fc31f:part:002"
        }
      ]
    },
