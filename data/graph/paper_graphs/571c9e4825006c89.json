  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "precipitation strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "short-term aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 6,
          "section": "Discussion",
          "quote": "This is because all W, Mo, Nb are gamma-prime-formers, and the first principles calculation results show that in the gamma-prime-Co3(Al,W), Mo and Nb atoms tend to occupy the lattice site of W atoms, but Mo and Nb have different formation ability of gamma-prime phase. It leads to the results that replacing W by Nb increase gamma-prime volume fraction, while replacing W by Mo decreases the gamma-prime volume fraction under the same heat treatment condition. Eventually the variations of the gamma-prime volume fraction for the alloys result in the opposite effects on the mechanics performance.",
          "table": null,
          "figure": null,
          "chunk_id": "571c9e4825006c89:part:001"
        }
      ]
