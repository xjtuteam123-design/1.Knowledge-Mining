  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "diffusion-assisted microtwinning",
      "category": "deformation",
      "sample_id": "sample_1",
      "material_state": "solution treated and aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 18,
          "section": "2.2. Microtwinning shearing in Ni-based superalloys",
          "quote": "The diffusion of Co and Cr to this pseudo microtwin relaxes the wrong atomic structure and transforms this high energy fault to a low energy true microtwin embryo or superlattice extrinsic stacking fault (SESF) [Smith et al. 2016, Freund et al. 2017, Barba et al. 2017] (Fig. 4c-3). The advance of the twin partials is now limited by the segregation of Co and Cr to the growing fault (Fig. 4c-4). This implies long range diffusion and, therefore, a time-dependent shearing of the precipitates. In the present work, this is named diffusion-assisted plasticity and, constitutively, is treated as a phase transformation.",
          "table": null,
          "figure": "Fig. 4c",
          "chunk_id": "fdbed60110426a29:part:001"
        },
        {
          "page": 23,
          "section": "3.2 Thermodynamics",
          "quote": "The formation of stacking faults and microtwins has been observed to be triggered by local chemical changes",
          "table": null,
          "figure": null,
          "chunk_id": "fdbed60110426a29:part:002"
        }
      ]
    },
