  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dislocation pile-up at phase interface",
      "category": "deformation",
      "sample_id": "sample_1",
      "material_state": "homogenized at 940 °C for 2 h and air cooled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "3.3. Mechanism of microcrack nucleation",
          "quote": "It will be difficult for dislocations across the phase boundary when the β and α phase do not meet the relationship, which will produce large stress concentration at the interfaces. If the stress concentration is not relieved by the deformation of the adjacent α phase, microcracks will nucleate along interfaces.",
          "table": null,
          "figure": null,
          "chunk_id": "1e31aa7578bbf200:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "grain boundary sliding",
      "category": "deformation",
      "sample_id": "sample_1",
