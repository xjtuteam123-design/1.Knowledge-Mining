      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": "5",
          "section": "3.4. Mechanism of microcrack propagation",
          "quote": "It has been proven that the gliding of interface becomes easier with the deformation temperature increasing, which will lead to a decline in interface strength.",
          "table": null,
          "figure": null,
          "chunk_id": "1e31aa7578bbf200:part:001"
        }
      ]
    }
