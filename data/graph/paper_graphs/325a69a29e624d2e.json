      "evidence": [
        {
          "page": "2",
          "section": "Introduction",
          "quote": "we will illustrate this in a NiCoCr0.5V0.5 MEA",
          "table": null,
          "figure": null,
          "chunk_id": "325a69a29e624d2e:part:001"
        },
        {
          "page": "7",
          "section": "Methods",
          "quote": "Bulk NiCoCr1–χVχ (χ = 0.4, 0.5, 0.6, at.%) MEA ingots were prepared by magnetic levitation melting of high-purity constituent metals (>99.9 wt%) under a high-purity argon atmosphere. The as-cast ingots (60 mm in height × 90 mm in diameter) were homogenized at 1150 °C for 2 h under argon, followed by hot forging into billets (240 mm (length) × 40 mm (width) × 40 mm (height)). Subsequent thermo-mechanical processing included cold rolling to 1.5 mm thickness (96% reduction) and annealing at 700–850 °C for 10–15 min with water quenching.",
          "table": null,
          "figure": null,
          "chunk_id": "325a69a29e624d2e:part:002"
        }
      ]
    },
