  "alloy_systems": [
    {
      "id": "alloy_system_1",
      "name": "Al-Cr-Fe-Co-Ni high-entropy alloy",
      "material_category": "high-entropy alloy",
      "evidence": [
        {
          "page": 4,
          "section": "2. Commonly Studied Alloys",
          "quote": "In the very initial stage of HEA research field, AlxCrFeCoNiCu HEAs have received wide attention... researchers shifted their focus to AlxCrFeCoNi HEA system, alloys without Cu.",
          "table": null,
          "figure": null,
          "chunk_id": "53b60b7d4263ee9a:part:001"
        },
        {
          "page": 17,
          "section": "Oxidation behavior",
          "quote": "Bulter et al. [225] investigated the oxidation behavior of Al10Cr22.5Fe22.5Ni22.5Co22.5 (Al10) and Al 20Cr25Ni25Co25Si5 (Al20-S) HEAs at 1050 /C14 C in dry air.",
          "table": null,
          "figure": null,
          "chunk_id": "53b60b7d4263ee9a:part:002"
        }
      ]
    },
    {
      "id": "alloy_system_2",
      "name": "Cr-Mn-Fe-Co-Ni high-entropy alloy",
      "material_category": "high-entropy alloy",
      "evidence": [
        {
          "page": 4,
          "section": "2. Commonly Studied Alloys",
          "quote": "CrMnFeCoNi HEA, also known as Cantor alloy, has been the alloy of interest of late due to the formation of a single phase with enhanced mechanical properties, particularly at the cryogenic temperature.",
          "table": null,
          "figure": null,
          "chunk_id": "53b60b7d4263ee9a:part:001"
        },
        {
          "page": 17,
          "section": "Oxidation behavior",
          "quote": "Laplance et al. [229] investigated the oxidation behavior of CrMnFeCoNi HEA in the temperature range of 500 – 900 /C14 C for the time duration of 100 h in the laboratory air.",
          "table": null,
          "figure": null,
          "chunk_id": "53b60b7d4263ee9a:part:002"
        }
      ]
    },
    {
      "id": "alloy_system_3",
      "name": "refractory high-entropy alloy",
      "material_category": "refractory high-entropy alloy",
      "evidence": [
        {
          "page": 14,
          "section": "5. Refractory High-Entropy Alloys",
          "quote": "Senkov et al. attempted to produce HEAs based on refractory elements with superior high-temperature properties over superalloys for high-temperature applications. The NbMoTaW and VNbMoTaW refractory HEAs exhibited single BCC phase, very high hardness, and very high yield strength at elevated temperatures.",
          "table": null,
          "figure": null,
          "chunk_id": "53b60b7d4263ee9a:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_4",
      "name": "Ti-Cr-Zr-Nb-Mo-Ta refractory high-entropy alloy",
      "material_category": "refractory high-entropy alloy",
      "evidence": [
        {
          "page": 18,
          "section": "Oxidation behavior",
          "quote": "Senkov et al. [48] investigated the oxidation behavior of TiCrZrNbMo0.5Ta0.5 refractory HEA at 1000 /C14 C for 1000 h in air and demonstrated better oxidation resistance than commer- cial Nb alloys.",
          "table": null,
          "figure": null,
          "chunk_id": "53b60b7d4263ee9a:part:002"
        }
      ]
    },
    {
      "id": "alloy_system_5",
      "name": "Ni-Co-Fe-Cr-Si-Al-Ti high-entropy alloy coating",
      "material_category": "high-entropy alloy coating",
      "evidence": [
        {
          "page": 18,
          "section": "Thermal Stability of HEA Coatings",
          "quote": "Hsu et al. [235,236] investigated the NiCo 0.6-Fe0.2Cr1.5SiAlTi0.2 HEA coating processed by SPS and atmo- spheric plasma spray (APS) and compared the results with MCrAlY .",
          "table": null,
          "figure": null,
