      "evidence": [
        {
          "page": 2,
          "section": "2. Materials & Methods",
          "quote": "The Ti-1.5Ru button ingot with a diameter of 50 mm and a height 25 mm was arc-melted using 99.99 % pure Ti and 99.95 % pure Ru metals. The ingot was homogenized at 1373 K for 20 h in an Ar atmosphere and water-quenched, then hot-rolled at 1173 K to a final thickness of 10 mm and air-cooled. The rolled plate was cut into sheets after removing the oxide surfaces on a milling machine. These sheets were sealed in quartz tubes filled with Ar gas and solution-treated at 1173 K (β region [18,19]) for 10 min, followed by water quenching to obtain the water-quenched (WQ) samples for the present study.",
          "table": null,
          "figure": null,
          "chunk_id": "fdd355547b2b89ae:part:001"
        },
        {
          "page": 10,
          "section": "4. Conclusions",
          "quote": "The water-quenched Ti-1.5Ru alloy exhibits a duplex micro -structure consisting of α blocks embedded within a matrix of α ′ martensites and retained β .",
          "table": null,
          "figure": null,
          "chunk_id": "fdd355547b2b89ae:part:002"
        }
      ]
    }
