      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "The elastic constants of temperature dependence, thermal expansion coefficient and phonon dispersion relations of γ-TiAl doped with C/O have been investigated using first-principles calculations in order to gain insight into the mechanical performance of γ-TiAl in cases of high temperature.",
          "table": null,
          "figure": null,
          "chunk_id": "51efc40393fd683f:part:001"
        },
        {
          "page": 1,
          "section": "Introduction",
          "quote": "γ-TiAl alloys have received much attention for their broad application prospects in the aerospace, automotive, chemical and marine industries because of their low density, high specific strength and stiffness, high resistance to high temperature creep, oxidation and hydrogen embrittlement [1–5].",
          "table": null,
          "figure": null,
          "chunk_id": "51efc40393fd683f:part:001"
        },
        {
          "page": "9",
          "section": "4. Conclusions",
          "quote": "the γ-TiAl alloy exhibits an electronic state at−11.39 eV",
          "table": null,
          "figure": null,
          "chunk_id": "51efc40393fd683f:part:002"
        }
      ]
    }
