  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "nitrogen penetration and internal nitridation",
      "category": "environmental degradation",
      "sample_id": "sample_1",
      "material_state": "thermally exposed at 1100 °C in air",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3. Results and discussion",
          "quote": "When the protective oxide scale loses its effectiveness due to defects such as cracks and pores or exfoliation, internal nitridation of Ni-based alloys can happen [ 11,14,22,26].",
          "table": null,
          "figure": null,
          "chunk_id": "f542109e3ba91369:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "refractory element depletion by TCP phase formation",
      "category": "phase transformation",
      "sample_id": "sample_1",
      "material_state": "thermally exposed at 1100 °C in air",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3. Results and discussion",
          "quote": "the formation of TCP phases results in depleting refractory elements, most of which prefer to partition to the austenitic c phase and stabilize it.",
          "table": null,
          "figure": null,
          "chunk_id": "f542109e3ba91369:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "Al enrichment around TCP phase",
      "category": "elemental segregation",
      "sample_id": "sample_1",
      "material_state": "thermally exposed at 1100 °C in air",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3. Results and discussion",
          "quote": "In this scenario, Al is left around TCP phases and Al-sufﬁcient areas are formed, which could affect the oxidization of the alloy.",
          "table": null,
          "figure": null,
          "chunk_id": "f542109e3ba91369:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "AlN formation by nitrogen-aluminum reaction",
      "category": "phase transformation",
      "sample_id": "sample_1",
      "material_state": "thermally exposed at 1100 °C in air",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3. Results and discussion",
          "quote": "Therefore, a chemical reaction occurs between nitrogen and the highly active and sufﬁcient Al cations in this Ti-free Ni-based superalloy during the thermal exposure. The AlN phase (marked as C) appears near the TCP phase, as shown in ﬁgure 6b.",
          "table": null,
          "figure": "Figure 6b",
          "chunk_id": "f542109e3ba91369:part:001"
        }
      ]
    },
    {
      "id": "mechanism_5",
      "name": "TCP phase formation promoted by refractory element segregation",
      "category": "phase transformation",
      "sample_id": "sample_1",
      "material_state": "thermally exposed at 1100 °C in air",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3. Results and discussion",
          "quote": "At this stage, due to the low-diffusion coefﬁcient of refractory elements [ 34–37], segregation of refractory elements is initiated and the formation of TCP phases is promoted.",
