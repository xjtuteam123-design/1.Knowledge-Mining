      "material_state": "as-sintered",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "abstract",
          "quote": "The excellent mechanical properties of the alloy were attributed to the grain boundary strengthening and the strengthening effect of (Ti, Nb)C that hindered the movement of dislocations.",
