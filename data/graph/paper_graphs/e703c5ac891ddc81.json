  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "destabilizing effect of Co on η phase",
      "category": "phase stability",
      "sample_id": "sample_1",
      "material_state": "dual-annealed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3. Discussion",
          "quote": "It is therefore believed that the destabilizing effect of Co should be considered when establishing the composition criteria towards the stability of η phase, since Co addition in superalloys has been widely accepted to be beneficial for improving the microstructural stability by suppressing the precipitation of η and TCP phases",
          "table": null,
          "figure": null,
          "chunk_id": "e703c5ac891ddc81:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "Co promotes formation of γ′-Co3Ti",
      "category": "phase competition",
      "sample_id": "sample_1",
      "material_state": "dual-annealed",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": 4,
          "section": "3. Discussion",
          "quote": "One potential explanation for this behavior is that a sufficient amount of Co would promote the formation of γ′-Co3Ti phase. At a relatively low alloying level in Ni-based superalloys, Co will occupy the Ni lattice site in γ′-Ni3Al strengthening phase and change its formula to γ′-(Ni,Co)3Al",
          "table": null,
          "figure": null,
          "chunk_id": "e703c5ac891ddc81:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "Co consumes Ti, Nb and Ta atoms",
      "category": "solute partitioning",
      "sample_id": "sample_1",
      "material_state": "dual-annealed",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": 4,
          "section": "3. Discussion",
          "quote": "Once a critical limit, about 12 at.% as suggested in Fig. 5 (d), is approached, the Co atoms tend to consume Ti, Nb and Ta atoms to form Co3Ti-based γ′-(Co,Ni)3(Ti,Nb,Ta,Al) phase, and therefore results in a marked decrease in the precipitation tendency of η phase",
          "table": null,
          "figure": "Fig. 5(d)",
          "chunk_id": "e703c5ac891ddc81:part:001"
        }
      ]
    }
  ],
