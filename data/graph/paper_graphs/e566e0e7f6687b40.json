    {
      "id": "alloy_system_1",
      "name": "refractory high-entropy alloy",
      "material_category": "refractory high-entropy alloy",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "Although refractory high-entropy alloys (RHEAs) possess excellent softening resistance and thermal stability at high temperatures, their practical application is often limited due to room temperature (RT) brittleness.",
          "table": null,
          "figure": null,
          "chunk_id": "e566e0e7f6687b40:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_2",
      "name": "Ta-Mo-Zr-Ti-Al refractory high-entropy alloy",
      "material_category": "refractory high-entropy alloy",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "the newly developed TaMoZrTiAl RHEA is featured by a hard disordered BCC phase embedded into a soft intermetallic B2 matrix",
          "table": null,
          "figure": null,
          "chunk_id": "e566e0e7f6687b40:part:001"
        },
        {
          "page": 9,
          "section": "3.5 Microstructure evolution",
          "quote": "For the current Ta-Mo-Zr-Ti-Al system, Ta-Ti and Ta-Zr have a positive mixing enthalpy thus helping decrease the SFE.",
          "table": null,
          "figure": null,
          "chunk_id": "e566e0e7f6687b40:part:002"
        },
        {
          "page": 16,
          "section": "5. Conclusions",
          "quote": "By employing the phase separation property and the CALPHAD approach, we successfully prepared a novel Ta23Mo23Zr23Ti23Al8 (23Zr) RHEA with in situ forming HS consisting of a ductile (Zr, Al)-rich B2 matrix and a hard (Ta, Mo)-rich BCC phase",
          "table": null,
          "figure": null,
          "chunk_id": "e566e0e7f6687b40:part:003"
        }
      ]
    }
  ],
