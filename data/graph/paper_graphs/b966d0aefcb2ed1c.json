  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "grain boundary pinning",
      "category": "microstructural",
      "sample_id": "sample_4",
      "material_state": "as-built",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": null,
          "section": null,
          "quote": "Considering these data and previous literature, the governing mechanism of grain reﬁnement is likely not inoculation but that La 2O3 is acting as a grain boundary pinner, and inhibiting, though not fully removing, the would-be epitaxial growth effect of the previous layer’s microstructure on the next solidifying layer.",
          "table": null,
          "figure": null,
          "chunk_id": "b966d0aefcb2ed1c:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "grain refinement",
