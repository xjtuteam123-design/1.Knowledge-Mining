  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid-solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "5",
          "section": "3.4. Temperature-dependent mechanical properties",
          "quote": "similar strength evolution was also reported for the γʹ-strengthened Co–Al–W- [2], Co–V–Ta- [20], and Co–Al–Ta-based superalloys [47], which was attributed to the so-called Kear-Wilsdorf mechanism [52,53]",
          "table": null,
          "figure": null,
          "chunk_id": "b4dd35f8bed2517f:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "Kear-Wilsdorf mechanism",
      "category": "deformation",
      "sample_id": "sample_1",
      "material_state": "aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "5",
          "section": "3.4. Temperature-dependent mechanical properties",
          "quote": "the so-called Kear-Wilsdorf mechanism [52,53]. The screw segments of super-dislocations cross slip from {111} plane to {100} plane at elevated temperature, due to {100} plane has lower anti-phase boundary (APB) energy in comparison with that of {111} plane [54], which makes the dislocation gliding more difficult and results in the anomalous hardening.",
          "table": null,
          "figure": null,
          "chunk_id": "b4dd35f8bed2517f:part:001"
        }
      ]
    }
  ],
