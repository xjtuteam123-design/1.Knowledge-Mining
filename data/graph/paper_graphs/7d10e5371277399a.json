    {
      "id": "sample_2",
      "original_name": "HT-1",
      "canonical_name": "Ti-22Al-25Nb",
      "alloy_system_id": "alloy_system_1",
      "material_state": "heat-treated",
      "composition": [],
      "evidence": [
        {
          "page": "2",
          "section": "2. Material and experiments",
          "quote": "Three isothermal forging schedules: 980 °C (HT-1: α2 + B2 + O phase region), 1040 °C (HT-2: α2 + B2 phase region) and 1060 °C (HT-3: B2 phase region) were used to improve the alloy properties. Isothermal forging was carried out at strain rates of 0.05 s−1. The height reduction of the cylindrical cakes was more than 50% in one stroke. The isothermal forged alloys were then machined to form cylinders of 13 mm diameter and 14 mm height for heat treatment. The specimens were solution-treated at 940 °C for 1 h followed by water quenching, and then age-treated at 800 °C for 12 h followed by air cooling to study creep and tensile properties.",
          "table": null,
          "figure": null,
          "chunk_id": "7d10e5371277399a:part:001"
        }
      ]
