  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "grain boundary strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "solution treated and aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3 | CONSTITUTIVE MODEL",
          "quote": "High-angle grain boundaries in the γ matrix may act as barriers to dislocation glide. Accordingly, this has been modeled using a Hall–Petch type term, which gives the increase in strength as an inverse of the square root of the grain size, that is, Δσ gb ¼ f kHPﬃﬃﬃ d p",
          "table": null,
          "figure": null,
          "chunk_id": "cf248f144bc951d2:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "solid solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "solution treated and aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3 | CONSTITUTIVE MODEL",
          "quote": "Several alloying elements are added to Ni-based superalloys to enhance their mechanical properties due to solid solution strengthening. Gypen and Deruyttere 37 proposed a model for solid solution strengthening of the nickel matrix-based alloy that assumes superposition of the strengthening due to individual solute species with different potencies.",
          "table": null,
          "figure": null,
          "chunk_id": "cf248f144bc951d2:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "precipitate strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "solution treated and aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3 | CONSTITUTIVE MODEL",
          "quote": "These ordered precipitates are the main contributors to the strength of IN 718. Ordered precipitates in the path of glide dislocations may get sheared by the dislocations.",
          "table": null,
          "figure": null,
          "chunk_id": "cf248f144bc951d2:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "dislocation strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "solution treated and aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3 | CONSTITUTIVE MODEL",
          "quote": "The strength contribution due to the dislocation density is given by a Taylor hardening model, Δσdislocation ¼ Gb ﬃﬃﬃﬃﬃﬃﬃﬃﬃﬃﬃﬃqρ ρtot p",
          "table": null,
          "figure": null,
          "chunk_id": "cf248f144bc951d2:part:001"
        }
      ]
    },
    {
      "id": "mechanism_5",
      "name": "precipitate shearing",
      "category": "softening",
      "sample_id": "sample_1",
      "material_state": "cyclic deformed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 6,
          "section": "3.2 | Cyclic softening",
          "quote": "Physically, the cyclic softening has generally been attributed to successive shearing of coherent and ordered γ00 precipitates by dislocations during cyclic deformation. This successive shearing leads to a progressive reduction in size up to a point where they offer no resistance to the dislocation movement.",
          "table": null,
          "figure": null,
          "chunk_id": "cf248f144bc951d2:part:001"
        }
      ]
    }
