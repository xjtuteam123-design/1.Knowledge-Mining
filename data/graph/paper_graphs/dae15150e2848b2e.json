      "name": "refractory complex concentrated alloy (RCCA)",
      "material_category": "refractory complex concentrated alloy",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "Correlations were explored between mechanical, thermodynamic and physical properties of refractory complex concentrated alloys (RCCAs).",
          "table": null,
          "figure": null,
          "chunk_id": "dae15150e2848b2e:part:001"
        },
        {
          "page": 7,
          "section": null,
          "quote": "Table 1 shows nine reported RCCAs with yield stress above 400 MPa at 1200 ◦C.",
          "table": "Table 1",
          "figure": null,
          "chunk_id": "dae15150e2848b2e:part:002"
        },
        {
          "page": 14,
          "section": "5. Summary and conclusions",
          "quote": "Using experimental data in the open literature, the room tempera - ture (RT) ductility and high-temperature (HT) strength of RCCAs are correlated against CALPHAD estimates of the liquidus temperature ( T L ) and rule-of-mixtures (ROM) estimates for elastic properties, density ( ρ ) and valence electron concentration (VEC).",
          "table": null,
          "figure": null,
          "chunk_id": "dae15150e2848b2e:part:003"
        }
      ]
    },
