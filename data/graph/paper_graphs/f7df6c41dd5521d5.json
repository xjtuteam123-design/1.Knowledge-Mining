      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 11,
          "section": "DISCUSSION OF RESULTS",
          "quote": "The data for W, Ta, and Hf additions suggest that atomic size misfit parameter may be important in controlling hardness in these systems.",
