    "document_type": "literature",
    "title": "High temperature materials for aerospace applications: Ni-based superalloys and γ-TiAl alloys",
    "authors": [
      "Mikael Perrut",
      "Pierre Caron",
      "Marc Thomas",
      "Alain Couret"
    ],
    "journal": "Comptes Rendus Physique",
    "year": 2018,
