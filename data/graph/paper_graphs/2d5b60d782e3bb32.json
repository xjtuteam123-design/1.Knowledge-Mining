  "alloy_systems": [
    {
      "id": "alloy_system_1",
      "name": "chromium-based alloy",
      "material_category": "refractory metal alloy",
      "evidence": [
        {
          "page": "1",
          "section": "Introduction",
          "quote": "Chromium metal has been considered as a possible base for alloy systems since the late 1940s due to its high melting point (1,863°C), good oxidation resistance, low density (20% less than most nickel-based superalloys), and high thermal conductivity (two to four times higher than most superalloys).",
          "table": null,
          "figure": null,
          "chunk_id": "2d5b60d782e3bb32:part:001"
        },
        {
          "page": "5",
          "section": "CREEP AND RUPTURE",
          "quote": "In the development of alloys for use as vanes or blades in gas-turbine engines, good creep strength at high temperatures is a major requirement. However, pure chromium has very low creep resistance.",
          "table": null,
          "figure": null,
          "chunk_id": "2d5b60d782e3bb32:part:002"
        }
      ]
    },
    {
      "id": "alloy_system_2_part002",
      "name": "Cr-Mo alloy",
      "material_category": null,
      "evidence": [
        {
          "page": "5",
          "section": "CREEP AND RUPTURE",
          "quote": "By using solid-solution hardening of molybdenum and tungsten, the tensile creep strength of extruded chromium at 950°C can be substantially improved.",
          "table": null,
          "figure": null,
          "chunk_id": "2d5b60d782e3bb32:part:002"
        }
      ]
    },
    {
      "id": "alloy_system_3",
      "name": "Cr-Ta alloy",
      "material_category": null,
      "evidence": [
        {
          "page": "5",
          "section": "CREEP AND RUPTURE",
          "quote": "Alloying with tantalum or niobium is also beneficial to the creep strength and the creep life of Cr-2.0Ta is more than 120 h at 1,050 °C under constant tensile load of 101 MPa.",
          "table": null,
          "figure": null,
          "chunk_id": "2d5b60d782e3bb32:part:002"
        }
      ]
    },
    {
      "id": "alloy_system_4",
      "name": "Cr-Ag alloy",
      "material_category": null,
      "evidence": [
        {
          "page": "5",
          "section": "FUTURE WORK",
          "quote": "Recent research has demonstrated that the tensile ductility of commercialy pure chromium (99.8 at.%) can be dramatically improved by alloying with trace silver. A Cr-Ag alloy was subjected to about 20% tensile elongation at ambient temperature, which creates a definite possibility to produce the ductile chromium-based alloys for use at high temperatures.",
          "table": null,
          "figure": null,
          "chunk_id": "2d5b60d782e3bb32:part:002"
        }
      ]
    }
