      "input_state": "wrought stress-relieved plate",
      "output_state": "machined compact-tension specimen",
      "evidence": [
        {
          "page": 4,
          "section": "Experimental Procedures",
          "quote": "Compact-tension (CT) specimens (19.8 mm in width, 19.1 mm in height, and 4.8 mm in thickness [35]) were fabricated using electrode-discharge machining with the notch/crack in either the LT (longitudinal) or TL (transverse) orientation [36].",
          "table": null,
          "figure": null,
          "chunk_id": "282acdc0a44f6893:part:001"
        }
      ]
    },
    {
      "id": "process_2",
      "sample_id": "sample_1",
      "sequence": 2,
      "method": "fatigue precracking",
      "parameters": {
        "temperature_c": 25,
        "time": null,
        "pressure": null,
        "atmosphere": null,
        "cooling_method": null,
        "deformation": null,
        "strain_rate": null,
        "laser_power_w": null,
        "scan_speed": null,
        "layer_thickness": null,
        "other": {
          "load_ratio_R": "0.04-0.06",
          "cycles": "37,000 to 4,890,000",
          "frequency_Hz": "10-15",
          "max_stress_intensity_MPa_sqrt_m": 45,
          "a/W_ratio": "0.52 to 0.60"
        }
      },
      "input_state": "machined compact-tension specimen",
      "output_state": "precracked specimen",
      "evidence": [
        {
          "page": 4,
          "section": "Experimental Procedures",
          "quote": "The specimens were fatigue-precracked at ambient temperature (25°C) under compression/compression cyclic loads at 10-15 Hz using ASTM procedures as a guide [37,38]. The maximum stress intensity factor was computed by treating the specimen as a single-edge crack in uniform compression [39] and was nominally 45 MPa√m for each specimen. The pre-cracking was performed with a load ratio, R, of 0.04-0.06 for 37,000 to 4,890,000 cycles to produce an a/W ratio ranging from 0.52 to 0.60.",
          "table": null,
          "figure": null,
          "chunk_id": "282acdc0a44f6893:part:001"
        }
      ]
    },
    {
      "id": "process_3",
      "sample_id": "sample_1",
      "sequence": 3,
      "method": "ion etching",
      "parameters": {
        "temperature_c": null,
        "time": "30-60 minutes",
        "pressure": "3.8 × 10-6 torr",
        "atmosphere": "Argon",
        "cooling_method": null,
        "deformation": null,
        "strain_rate": null,
        "laser_power_w": null,
        "scan_speed": null,
        "layer_thickness": null,
        "other": {
          "beam_energy_keV": 8
        }
      },
      "input_state": "precracked specimen",
      "output_state": "ion-etched specimen",
      "evidence": [
        {
          "page": 4,
          "section": "Experimental Procedures",
          "quote": "After fatigue precracking, the test specimens were ion-etched in an ion sputter system operated at 8 KeV, 3.8 × 10-6 torr pressure, under an Argon beam for 30-60 minutes to reveal the microstructure and to condition the surfaces for imaging in the SEM [35].",
          "table": null,
