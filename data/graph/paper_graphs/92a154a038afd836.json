      "evidence": [
        {
          "page": 4,
          "section": "3.1",
          "quote": "Using energy-dispersive X-ray analysis and electron microprobe analysis, these particles were indicated to be a Cu-Ni-Ti intermetallic having the approximate composition NisCusTi6. These coarser particles, which we shall call the modified ~? phase, are extremely stable thermally even when heated to 1273 K. The designation, modified ~?, is used here because it was found that this phase has an h.c.p, structure similar to that of the binary ~ phase (Ni3Ti) commonly found in nickel-base superalloys and austenitic stainless steels.",
          "table": null,
          "figure": null,
          "chunk_id": "92a154a038afd836:part:001"
        }
      ]
    },
