  "alloy_systems": [
    {
      "id": "alloy_system_1",
      "name": "γ-TiAl matrix composite",
      "material_category": "intermetallic matrix composite",
      "evidence": [
        {
          "page": "1",
          "section": "Abstract",
          "quote": "Gamma-TiAl matrix composites can function as promising high-temperature structural materials. In this study, to improve the poor ductility and insufficient strength of composites at high temperatures, they were successfully prepared via powder metallurgy by adding the Ti–6Al–4V alloy.",
          "table": null,
          "figure": null,
          "chunk_id": "6aab0e3984de558b:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_2",
      "name": "Ti-48Al-2Cr-2Nb alloy",
      "material_category": "γ-TiAl alloy",
      "evidence": [
        {
          "page": "2",
          "section": "2. Experimental procedure",
          "quote": "The gas-atomized Ti–48Al–2Cr–2Nb pre-alloy powders (purity > 99.9 wt%, referred to as Ti4822) and Ti–6Al–4V pre-alloy powders (purity > 99.9 wt%, referred to as TC4) were used as raw materials in the present work.",
          "table": null,
          "figure": null,
          "chunk_id": "6aab0e3984de558b:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_3",
      "name": "Ti-6Al-4V alloy",
      "material_category": "α+β titanium alloy",
      "evidence": [
        {
          "page": "2",
          "section": "1. Introduction",
          "quote": "The Ti–6Al–4V alloy is a typical α + β phase alloy.",
          "table": null,
          "figure": null,
          "chunk_id": "6aab0e3984de558b:part:001"
        }
      ]
    }
