  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "cross-kink collisions",
      "category": "dislocation",
      "sample_id": "sample_1",
      "material_state": "creep tested (steady-state)",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "1",
          "section": "Abstract",
          "quote": "Transmission electron microscopy revealed that creep deformation in Nb45Ta25Ti15Hf15 at 1173 K is controlled by cross-kink collisions from screw dislocations that results in dipole drag at lower strain rates and jog drag at higher strain rates.",
          "table": null,
          "figure": null,
          "chunk_id": "fbbcf0babdd500aa:part:001"
        }
      ]
    },
