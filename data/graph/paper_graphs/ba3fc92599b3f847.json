  "paper_metadata": {
    "document_type": "literature",
    "title": "Microstructures of binary Cr–xNi alloys (0 ≤ Ni ≤ 50 wt.%) in their as-cast state and after high temperature exposure",
    "authors": [
      "Elodie Conrath",
      "Patrice Berthod"
    ],
    "journal": "Materials at High Temperatures",
    "year": 2016,
    "doi": "10.1080/09603409.2016.1144317"
  },
  "alloy_systems": [
    {
      "id": "alloy_system_1",
      "name": "Cr-Ni alloy",
      "material_category": "binary chromium-based alloy",
      "evidence": [
        {
          "page": 2,
          "section": "Abstract",
          "quote": "several binary alloys, chosen in the Cr-rich part of the Cr–Ni diagram, were elaborated by foundry and characterised by metallography in the as-cast condition and after exposure at 1200 °C.",
          "table": null,
          "figure": null,
          "chunk_id": "ba3fc92599b3f847:part:001"
        },
        {
          "page": "9",
          "section": "Conclusions",
          "quote": "some potentially interesting imbricated microstructures of Cr-rich BCC phase (favouring oxidation resistance) and FCC phase (favouring mechanical strength) may be obtained in this system.",
          "table": null,
          "figure": null,
          "chunk_id": "ba3fc92599b3f847:part:002"
        }
      ]
    }
  ],
