      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "The prevalence of hot cracking in precipitation-strengthened alloy 718 is primarily governed by two factors: firstly, the chemical composition and the coarse microstructure formed during solidification, and secondly, the activation of hot cracking mechanisms, which is particularly critical in mushroom-shaped welding morphologies.",
          "table": null,
          "figure": null,
          "chunk_id": "6d306e16d9eddad0:part:001"
        },
        {
          "page": 14,
          "section": "4. Discussion",
          "quote": "in cast Alloy 718, weld cracking in the heat-affected zone (HAZ) is caused by the liquation of secondary phases and precipitates.",
          "table": null,
          "figure": null,
          "chunk_id": "6d306e16d9eddad0:part:002"
        }
      ]
    }
