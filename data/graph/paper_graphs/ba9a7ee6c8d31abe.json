      },
      "input_state": "SuperCMV and AerMet 100 base metals",
      "output_state": "as-welded AerMet-SCMV weld",
      "evidence": [
        {
          "page": "2",
          "section": "Introduction to Friction Welding",
          "quote": "In inertia friction welding the process is very similar to continuous drive friction welding, however one of the work pieces is connected to a flywheel, which provides the kinetic energy, whilst the other is restrained from rotating. The flywheel is accelerated to a predetermined rotational speed and is then disengaged. At this point the work pieces are forced together and the stored energy in the rotating flywheel is dissipated as heat through friction at the weld interface. An increase in forge force may be applied before rotation stops",
          "table": null,
          "figure": null,
          "chunk_id": "ba9a7ee6c8d31abe:part:001"
        }
      ]
    },
