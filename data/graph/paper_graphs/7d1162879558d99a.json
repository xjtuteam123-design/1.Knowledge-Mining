        {
          "page": 8,
          "section": null,
          "quote": "ERBOCo-1 develops a slightly rafted microstructure perpendicular to the applied stress axis. This is a consequence of a positive c/c¢ lattice misfit, causing tensile stresses in the matrix channels and formation of rafts perpendicular to the compressive stress axis, when the internal and external applied stresses superpose.",
          "table": null,
          "figure": "8",
          "chunk_id": "7d1162879558d99a:part:002"
        }
