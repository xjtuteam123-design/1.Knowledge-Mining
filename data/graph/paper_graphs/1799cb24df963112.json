      "evidence": [
        {
          "page": 2,
          "section": "Materials and methods",
          "quote": "Pellets corresponding to the equiatomic CoCrFeNi HEA composition were placed in a hemispherical water-cooled copper mold inside the chamber of an arc melting furnace which was then evacuated to 10−5 millibar. The furnace was purged with high-purity argon on attaining the desired level of vacuum, and melting was carried out by using the arc created by a non-consumable W electrode. Melting was repeated five times to ensure chemical homogeneity",
          "table": null,
          "figure": null,
          "chunk_id": "1799cb24df963112:part:001"
        }
      ]
    },
