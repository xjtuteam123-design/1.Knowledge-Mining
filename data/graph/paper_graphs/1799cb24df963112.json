      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "CoCrFeNi is a face-centered cubic (FCC) high entropy alloy (HEA) that exhibits high ductility both at room temperature and at cryogenic temperatures but has limited strength. The present study is focused on addition of TiB2 to the CoCrFeNi HEA with the goal of developing materials with better combinations of strength and ductility.",
          "table": null,
          "figure": null,
          "chunk_id": "1799cb24df963112:part:001"
        }
      ]
    }
