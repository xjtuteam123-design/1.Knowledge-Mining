  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "anomalous temperature dependence of strength",
      "category": "dislocation mechanism",
      "sample_id": "sample_1",
      "material_state": "heat-treated",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "2",
          "section": "RESULTS AND DISCUSSION",
          "quote": "This anomalous dependence is governed by the dislocation mechanism of plastic deformation of intermetallic Ni3Al (gamma-prime-phase), differing at high temperature from the deformation mechanism of disordered solid solutions based on nickel (gamma-phase) [5]. The reason of an anomalous change in sigma_r(T) and sigma_0.2(T) is specified by presence in the structure of blocking super-dislocations and a change in octahedral slip to cubic with transition through the peak temperature.",
          "table": null,
          "figure": null,
          "chunk_id": "e41d99fd7a8e5eb7:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
