      "evidence": [
        {
          "page": 3,
          "section": "2.1",
          "quote": "A planetary ball mill was used for mechanical alloying of elemental powders. The mill had a chamber made of hardened chromium steel and hardened high-carbon steel balls in three sizes: 20 mm, 15 mm, and 7 mm. Argon gas was used to prevent oxidation, and a rubber gasket sealed the chamber. The ball-to-powder weight ratio was 10:1, and the milling speed was 350 rpm. Additionally, 1.5 wt% stearic acid was added as a PCA to prevent particle agglomeration.",
          "table": null,
          "figure": null,
          "chunk_id": "dfcd50e92b82c79f:part:001"
