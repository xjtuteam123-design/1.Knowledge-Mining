  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "pinning effect",
      "category": "microstructural",
      "sample_id": "sample_5",
      "material_state": "rolled",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 2,
          "section": "Abstract",
          "quote": "The second phase of ZrO 2 particles demonstrated a pinning effect to retard recrystallization progress and thus enhance high temperature tensile stress and plasticity of the alloys effectively.",
