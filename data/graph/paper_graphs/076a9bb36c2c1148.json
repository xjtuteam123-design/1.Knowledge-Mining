      "name": "Ni-base superalloy",
      "material_category": "nickel-base superalloy",
      "evidence": [
        {
          "page": 1,
          "section": "INTRODUCTION",
          "quote": "Diffusion aluminide coatings are very widely used for protecting the external surface of turbine blades fabricated from high-temperature alloys from high-temperature oxidation.",
          "table": null,
          "figure": null,
          "chunk_id": "076a9bb36c2c1148:part:001"
        },
        {
          "page": "7",
          "section": null,
          "quote": "Double-stage ADAC provide high heat resistance of high-temperature alloys at the operational temperature (Fig. 6), raise their high-temperature strength by 10 – 15% (Table 6), and virtually do not affect the fatigue strength.",
          "table": null,
          "figure": null,
          "chunk_id": "076a9bb36c2c1148:part:002"
        }
      ]
    },
    {
      "id": "alloy_system_2",
      "name": "Ni-Al diffusion aluminide coating",
      "material_category": "diffusion aluminide coating",
      "evidence": [
        {
          "page": 1,
          "section": "INTRODUCTION",
          "quote": "The high protective properties of these coatings are determined by the properties of NiAl (β-phase) nickel aluminide that constitutes the base of the external layer of the coating.",
          "table": null,
          "figure": null,
          "chunk_id": "076a9bb36c2c1148:part:001"
        },
        {
          "page": "7",
          "section": null,
          "quote": "The suggested method for depositing complexly alloyed diffusion coatings makes it possible to widely vary the chemical composition of the coatings without changing the matrix heat-resistant phase of the coating, i.e., alloyed nickel monoaluminide",
          "table": null,
          "figure": null,
          "chunk_id": "076a9bb36c2c1148:part:002"
        }
      ]
    }
