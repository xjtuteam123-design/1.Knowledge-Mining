      "evidence": [
        {
          "page": 2,
          "section": "Experimental details",
          "quote": "MA of 100 g of the blend elemental powders was performed at room temperature up to 50 h in a high energy planetary ball mill (QM-3SP4). Stainless steel vials and balls (6 mm, 10 mm and 20 mm in diameter) were used. The weight ratio of the balls-to-powder was 10:1 and the rotating speed was 300 rpm. To prevent oxidation during MA, the vials were purged several times and ﬁlled with pure argon gas at 0.4 MPa. Cyclohexane was used as the process controlling agent (PCA).",
          "table": null,
          "figure": null,
          "chunk_id": "af6646f9f49e4815:part:001"
        }
      ]
    },
