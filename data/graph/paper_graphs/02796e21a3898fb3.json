          "figure": null,
          "chunk_id": "02796e21a3898fb3:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "cross-kink controlled screw dislocation motion",
      "category": "dislocation motion",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": null,
          "quote": "The motion of screw dislocations in RCCA is controlled by cross-kinks, which are non-glissile structures commonly observed in dislocations in these alloys. These cross-kinks possess high energy barriers and exhibit strong temperature dependence as shown in previous studies [17,62].",
          "table": null,
          "figure": null,
          "chunk_id": "02796e21a3898fb3:part:002"
        }
      ]
    }
