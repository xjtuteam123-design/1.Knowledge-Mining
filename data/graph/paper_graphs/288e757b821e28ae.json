          "figure": null,
          "chunk_id": "288e757b821e28ae:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "Lüders band yielding",
      "category": "deformation",
      "sample_id": "sample_4",
      "material_state": "as-annealed",
