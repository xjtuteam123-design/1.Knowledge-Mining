    {
      "id": "mechanism_1",
      "name": "grain boundary pinning",
      "category": "microstructural stabilization",
      "sample_id": "sample_1",
      "material_state": "thermal exposed at 760 °C for 100 h",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "3.2 Microstructures of heat-treated BG samples",
          "quote": "the microstructural stability of the BG structures in the alloy samples can be mainly attributed to two aspects. First, the global grain growth of this alloy at temperatures below 1000 °C is very slow due to the high activation energy (600 kJ/mol-1) for grain growth (GB migration) [30, 31]. This energy is very high compared to the activation energy for self-diffusion of pure cobalt (260 kJ/mol-1 [32]) and GB diffusion of pure cobalt (117 kJ/mol-1 [33]). This should be associated with the solute-drag effect as a consequence of the high-content solute elements (& 50%) in the present alloy [34]. Second, the pinning of the carbides also plays an important role in the microstructural stability.",
          "table": null,
          "figure": null,
          "chunk_id": "0d9906d506f2ea4e:part:001"
        }
      ]
