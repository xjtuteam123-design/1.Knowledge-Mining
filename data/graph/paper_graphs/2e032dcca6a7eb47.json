      "material_state": null,
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": 2,
          "section": "Results",
          "quote": "Crack defects were observed in all track melts performed on all Zr-containing alloys, including the quinary Hf2Zr7Ru9. Most cracks were positioned along the centerline of the melt with fracture propagation along dendritic arms, consistent with solidification cracking.",
