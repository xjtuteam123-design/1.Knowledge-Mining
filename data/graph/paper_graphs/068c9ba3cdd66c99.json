      "material_category": "superalloy",
      "evidence": [
        {
          "page": "1",
          "section": "Introduction",
          "quote": "These alloys can be categorized into ferritic superalloys [ 1 – 3 ] and refractory-element-based superalloys",
          "table": null,
          "figure": null,
          "chunk_id": "068c9ba3cdd66c99:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_3",
      "name": "refractory complex concentrated alloy (RCCA)",
      "material_category": "refractory high-entropy alloy",
      "evidence": [
        {
          "page": "1",
          "section": "Introduction",
          "quote": "The past decade has witnessed a surge of interest in refractory-element-based HEAs or re - fractory complex concentrated alloys (RCCAs) due to their high melting points and vast compositional flexibility, affording the possibility of microstructural and property optimization.",
          "table": null,
          "figure": null,
          "chunk_id": "068c9ba3cdd66c99:part:001"
        }
      ]
    },
    {
