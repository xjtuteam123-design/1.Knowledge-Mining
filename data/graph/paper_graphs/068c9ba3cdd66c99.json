      "id": "alloy_system_1",
      "name": "BCC-B2 superalloy",
      "material_category": "superalloy",
      "evidence": [
        {
          "page": "1",
          "section": "Abstract",
          "quote": "BCC + B2 superalloys, inspired by the γ / γ ′ micro - structure in Ni-based superalloys, feature a ductile BCC matrix with coherent B2 precipitates that enhance high- temperature strength and creep resistance.",
          "table": null,
          "figure": null,
          "chunk_id": "068c9ba3cdd66c99:part:001"
        }
      ]
    },
    {
      "id": "alloy_system_2",
