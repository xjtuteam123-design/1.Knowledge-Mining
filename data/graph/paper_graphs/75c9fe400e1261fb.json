  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dynamic strain aging",
      "category": "deformation mechanism",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3.2.2 Stress serrations",
          "quote": "sharp saw tooth type of oscillations accompanied strain hardening sections of the stress –strain curves and had an amplitude between 15 and 25 MPa; they are possibly associated with dynamic strain ageing phenomenon.",
          "table": null,
          "figure": null,
          "chunk_id": "75c9fe400e1261fb:part:001"
        },
        {
          "page": "7",
          "section": "4. Discussion",
          "quote": "They were associated with dynamic strain aging with an influx in solute atoms involved in the pinning and unpinning of dislocations (“solute drag” by carbon and nitrogen interstitials).",
          "table": null,
          "figure": null,
          "chunk_id": "75c9fe400e1261fb:part:002"
        }
      ]
    },
