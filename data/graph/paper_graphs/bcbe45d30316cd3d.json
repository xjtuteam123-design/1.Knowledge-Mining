  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dislocation source-limited behavior",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "5",
          "section": "Discussion",
          "quote": "the size effect on strength should be dominated by the dislocation mechanism. Volkert and Lilleodden proposed that dislocations could easily leave from sample surface and thus dislocation density is lower in smaller pillar.",
          "table": null,
          "figure": null,
          "chunk_id": "bcbe45d30316cd3d:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "grain boundary cracking",
      "category": "fracture",
      "sample_id": "sample_1",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "5",
          "section": "Discussion",
          "quote": "Crack initiation at triple junction of GBs. At a triple junction, plastic deformation across the GB is not continuous, thus slip steps and high tensile stress concentration appear, which leads to the crack initiation.",
          "table": null,
          "figure": null,
          "chunk_id": "bcbe45d30316cd3d:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "cleavage cracking",
      "category": "fracture",
      "sample_id": "sample_1",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "5",
          "section": "Discussion",
          "quote": "the splitting crack usually penetrates a grain in well-defined plane and then deflects as goes into another grain. This suggests the nature of splitting crack is actually transgranular cleavage cracking along specific cleavage planes.",
          "table": null,
          "figure": null,
          "chunk_id": "bcbe45d30316cd3d:part:001"
        }
      ]
    }
