  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "Mo/Ta addition effect on lattice constant and interatomic bonding",
      "category": "compositional effect",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "Results",
          "quote": "Addition of Mo and Ta increases the difference in electronegativity, thereby disrupting the stability of the lattice structure and ultimately leading to a decrease in the lattice constant of CCA alloys. The decrease in lattice constant indicates a decrease in atomic spacing, leading to strengthening of interaction forces, which contributes to the increase in modulus from a macroscopic perspective.",
          "table": null,
          "figure": "Fig. 6",
          "chunk_id": "4ff04ac58459c367:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "solid solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_3",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 9,
          "section": null,
          "quote": "the minimal atomic size difference in CCAs promotes formation of solid solutions, thereby further enhancing the stability of the single BCC phase.",
          "table": null,
          "figure": null,
          "chunk_id": "4ff04ac58459c367:part:002"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "high entropy stabilization",
      "category": "phase stabilization",
      "sample_id": "sample_3",
      "material_state": "as-cast",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 9,
          "section": null,
          "quote": "This phenomenon can be attributed to the high entropy resulted from multiple principal elements, which enhances the enhanced thermodynamic stability and effectively inhibits the precipitation of the high modulus ω phase.",
          "table": null,
          "figure": null,
          "chunk_id": "4ff04ac58459c367:part:002"
        }
      ]
    }
