  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "Y-Ti-O oxide particle formation",
      "category": "phase transformation",
      "sample_id": "sample_1",
      "material_state": "sintered",
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": "1",
          "section": "abstract",
          "quote": "During the sintering of the composite powder, TiC and Y 2O3 precipitations converted to Y-Ti-O precipitations.",
          "table": null,
          "figure": null,
          "chunk_id": "571537c7a00277d3:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "second-phase particle strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "sintered",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "4",
          "section": "3.3 Microstructure and fracture morphology of the composite",
          "quote": "The second phase was evenly distributed in the tungsten grain and grain boundary, hindering the slippage of the grain boundary, enhancing the binding force of grain boundary, and finally changing the fracture mode of tungsten.",
          "table": null,
          "figure": null,
          "chunk_id": "571537c7a00277d3:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "thermal shock cracking",
      "category": "failure",
      "sample_id": "sample_1",
      "material_state": "thermally shocked",
      "assertion_level": "directly_reported",
      "evidence": [
        {
          "page": "5",
          "section": "3.6 Thermal shock response of the composites",
          "quote": "The main reason for the cracking occurred in the laser beam shocked sample is that during the loading process, the tungsten surface absorbs a large amount of heat which leads to a sharp rise in temperature (exceeding the DBTT) and is in a state of ductile. In addition, due to local transient heating, the tungsten surface generates a large thermal stress. Once the stress exceeds yield strength of the composite, the material will undergo plastic deformation; and when the thermal shock disappeared, the material will cool down to the DBTT of tungsten very quickly. At this time, the material behaves as brittleness. Therefore, this deformation will directly lead to the material surface cracking.",
          "table": null,
          "figure": null,
          "chunk_id": "571537c7a00277d3:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "crack propagation along grain boundary",
      "category": "failure",
      "sample_id": "sample_1",
      "material_state": "thermally shocked",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "5",
          "section": "3.6 Thermal shock response of the composites",
          "quote": "Material strength was relatively weak at the grain boundary [ 26]; thus, the crack expanded easily along the grain boundary.",
