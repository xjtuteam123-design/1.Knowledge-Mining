      "name": "Re re-segregation",
      "category": "segregation",
      "sample_id": "sample_4",
      "material_state": "heat-treated",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "we propose that Re segregates to LAGBs during Bridgman processing, redissolves during the high temperature (>1300°C) solution phase, allowing LAGB migration, and then resegregates during the medium temperature (<1000°C) precipitation phase of the multi-step heat treatment",
          "table": null,
          "figure": null,
          "chunk_id": "0207a1323b2355ad:part:001"
        }
      ]
    },
    {
