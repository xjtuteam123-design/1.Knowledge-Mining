  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dislocation aggregation at phase boundaries",
      "category": "microstructural",
      "sample_id": "sample_1",
      "material_state": "deformed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "4. Discussion",
          "quote": "Dislocations are aggregating at the g/g0 phase boundaries with the result of relieving the coherency stress between g/g0 phases, which causes the large minishing of ag, reducing the lattice mismatch.",
          "table": null,
          "figure": null,
          "chunk_id": "7dde1ab822babbaf:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "interface coherency strain relaxation",
      "category": "micromechanical",
      "sample_id": "sample_1",
      "material_state": "deformed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "1",
          "section": "abstract",
          "quote": "The deformation-induced interface coherency strain relaxation was observed after yielding as evidenced by an increment of lattice mismatch and an abnormal decrease in full width at half maximum (FWHM), which is attributed to aggregating of dislocations toward phase boundaries.",
          "table": null,
          "figure": null,
          "chunk_id": "7dde1ab822babbaf:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "dislocation slip in gamma channels",
      "category": "deformation",
      "sample_id": "sample_1",
      "material_state": "deformed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "4. Discussion",
          "quote": "On application of a uniaxial external load at room temperature, deformation occurs in the matrix by dislocation slipping on the {111} /110S slipping system",
