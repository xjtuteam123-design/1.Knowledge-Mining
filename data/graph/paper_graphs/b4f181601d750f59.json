  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "elastic energy minimization by precipitate shape change",
      "category": "elasticity",
      "sample_id": "sample_2",
      "material_state": "crept",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "3",
          "section": "3. Results",
          "quote": "When the plastic strain is positive (tensile case), the disc-shaped particles normal to [0 0 1] show the lowest elastic energy. The diﬀerence in the elastic energy between the considered morphologies becomes larger as the plastic strain increases. This means that a tensile plastic strain tends to induce rafting.",
          "table": null,
          "figure": "Fig. 1",
          "chunk_id": "b4f181601d750f59:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "dislocation pipe diffusion",
      "category": "diffusion",
      "sample_id": "sample_2",
      "material_state": "crept",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": "5",
          "section": "4. Discussion",
          "quote": "The diﬀusion along the cores of dislocations is faster than interfacial or bulk diﬀusion. ... the dislocations left around a c 0 particle after matrix plastic deformation enhance a change in the particle shape by providing fast diﬀusion paths.",
          "table": null,
          "figure": null,
          "chunk_id": "b4f181601d750f59:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "particle shearing",
      "category": "yielding",
      "sample_id": "sample_2",
      "material_state": "crept",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": "6",
          "section": "4. Discussion",
          "quote": "Hence, we can reasonably speculate that c 0 particles start to yield by the accumulation of internal stress due to matrix plastic strain.",
          "table": null,
          "figure": null,
          "chunk_id": "b4f181601d750f59:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "precipitation strengthening",
