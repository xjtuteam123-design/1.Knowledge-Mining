    {
      "id": "alloy_system_1",
      "name": "Ni-Cr alloy",
      "material_category": "FCC binary Ni-based alloy",
      "evidence": [
        {
          "page": "1",
          "section": "Abstract",
          "quote": "we combined molecular dynamics (MD) simulations with a recently developed anisotropic multi-phase phase field model to investigate NT stability in two Ni-based binary alloys: Ni–Cr and Ni–Fe.",
          "table": null,
          "figure": null,
          "chunk_id": "1be66c91189b855b:part:001"
        },
        {
          "page": "8",
          "section": "Conclusions",
          "quote": "The molecular dynamics (MD) results show distinctly contrasting roles for alloying elements Cr and Fe in Ni: Cr significantly reduces the stacking fault and incoherent twin boundary (ITB) energies, promoting NT formation, whereas Fe has an opposite effect, potentially limiting NT formation and mobility.",
          "table": null,
          "figure": null,
          "chunk_id": "1be66c91189b855b:part:002"
        }
      ]
    },
    {
      "id": "alloy_system_2",
      "name": "Ni-Fe alloy",
      "material_category": "FCC binary Ni-based alloy",
      "evidence": [
        {
          "page": "1",
          "section": "Abstract",
          "quote": "we combined molecular dynamics (MD) simulations with a recently developed anisotropic multi-phase phase field model to investigate NT stability in two Ni-based binary alloys: Ni–Cr and Ni–Fe.",
          "table": null,
          "figure": null,
          "chunk_id": "1be66c91189b855b:part:001"
        },
        {
          "page": "7",
          "section": "Detwinning behavior in Ni‑Cr binary",
          "quote": "Our results show that FCC Ni–Fe exhibits substantially lower ITB mobility than Ni–Cr at the same temperature and concentration, suggesting that, if NTs could be synthesized in Ni–Fe, they would be much more thermally stable than in Ni–Cr.",
          "table": null,
          "figure": null,
          "chunk_id": "1be66c91189b855b:part:002"
        }
      ]
    }
  ],
