  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "multiple slip modes activation",
      "category": "deformation",
      "sample_id": "sample_2",
      "material_state": "aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "Abstract",
          "quote": "The ﬂow anomaly is attributed to the activation of multiple slip modes within the precipitates.",
          "table": null,
          "figure": null,
          "chunk_id": "89b571b8bad9752a:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "cross-slip pinning",
      "category": "deformation",
      "sample_id": "sample_2",
      "material_state": "aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 3,
          "section": "Results and discussion",
          "quote": "pinning of cross-slipped screw h110 i dislocation segments from the octahedral {1 1 1} plane to the cube {0 0 1} plane and are driven by elastic anisotropy and/or a lower anti-phase boundary (APB) energy on {0 0 1} planes",
          "table": null,
          "figure": null,
          "chunk_id": "89b571b8bad9752a:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "dislocation shearing",
