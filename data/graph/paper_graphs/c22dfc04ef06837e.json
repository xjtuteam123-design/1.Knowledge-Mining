      "evidence": [
        {
          "page": 7,
          "section": "3.3.2 Compression performance",
          "quote": "The excellent strength of NbMoTaNiCr alloy at elevated temperatures is mostly ascribed to the presence of the second phase which hinders the grain boundary sliding.",
          "table": null,
          "figure": null,
          "chunk_id": "c22dfc04ef06837e:part:001"
        }
      ]
    },
    {
