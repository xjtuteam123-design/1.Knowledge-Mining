  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid-solution strengthening",
      "category": "strengthening",
      "sample_id": "sample_1",
      "material_state": "as-built",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 6,
          "section": "3.3.1 Hardness",
          "quote": "due to the large size difference between atoms, the multiple principal alloying elements induce a high degree of lattice distortion and a significant solid solution strengthening effect when forming a single-phase solid solution, which leads to high hardness.",
          "table": null,
          "figure": null,
          "chunk_id": "c22dfc04ef06837e:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "grain refinement",
      "category": "microstructural",
      "sample_id": "sample_1",
      "material_state": "as-built",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 6,
          "section": "3.3.1 Hardness",
          "quote": "as the arc rotates, the melt pool is reciprocally stirred by the arc and the centrifugal force, so the cooling rate increases during the preparation process, resulting in a larger internal subcooling and a higher nucleating mass in the melt pool, which refines the grain size of the dendrites.",
          "table": null,
          "figure": null,
          "chunk_id": "c22dfc04ef06837e:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
