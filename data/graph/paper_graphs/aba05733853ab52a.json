  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "solid-solution strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": "4.2.1 Contributions of microstrutures to the RT mechanical properties",
          "quote": "Nb addition in the Ni–26W–6Cr alloy produces lattice distortion in the γ matrix (Fig. 4), and the corresponding long-range stress field will hinder the movement of dislocations during the tensile process.",
          "table": null,
          "figure": null,
          "chunk_id": "aba05733853ab52a:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "grain-refinement strengthening",
      "category": "strengthening",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": "4.2.1 Contributions of microstrutures to the RT mechanical properties",
