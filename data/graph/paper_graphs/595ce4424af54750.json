    {
      "id": "mechanism_1",
      "name": "local chemical order (LCO) facilitated dislocation multiple slips",
      "category": "deformation mechanism",
      "sample_id": "sample_1",
      "material_state": "deformed at strain rate 6500 s^-1",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "Discussion",
          "quote": "The LCOs stimulate dislocation multiplication, resulting in high-density dislocation debris (Fig. 3c(iii)), microband broadening (Fig. 3c(ii)) and resultant bifurcated deformed bands (Fig. 3c(i)).",
          "table": null,
          "figure": "Fig. 3c",
          "chunk_id": "595ce4424af54750:part:001"
        },
        {
          "page": "7",
          "section": null,
          "quote": "Furthermore, the LCOs-facilitated dislocation multiple slips alleviate the stress concentration, lead to the formation of multi-directional microbands and bifurcated deformed bands, delay the adiabatic shear failure and consequently improve the dynamic ductility.",
          "table": null,
          "figure": null,
          "chunk_id": "595ce4424af54750:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "dislocation accumulation counteracting thermal softening",
      "category": "deformation mechanism",
      "sample_id": "sample_2",
      "material_state": "deformed at strain rate 6500 s^-1",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": null,
          "quote": "Moreover, the high-density dislocations and nanocrystals in the deformed bands could counteract the thermal softening effect, which also contributes to the improved ultimate strength and ultimate strain.",
          "table": null,
          "figure": null,
          "chunk_id": "595ce4424af54750:part:002"
        }
      ]
    }
