      "evidence": [
        {
          "page": "1",
          "section": "2. Experimental procedures",
          "quote": "In this work, the raw materials of high purity Al, Co, Cr, Fe and Ni ( > 99.5 at% pure) was mixed for PPA-AM. The aimed Al17Cr17Co33Ni33 and AlCoCrFeNi2.1 samples were PPA-AMed by plasma deposition equipment (Shanghai Duomu DML-V03AD). The critical process parameters were selected as the current of 120 A, traveling speed of 405 mm/min, contact-tip-to-work distance of 12 mm and inter-layer waiting time of 3 min. The argon shielding gas with a flow rate of 10 L/min was supplied to shield alloys.",
          "table": null,
          "figure": null,
          "chunk_id": "3ee9d3dc64fd2164:part:001"
        }
      ]
