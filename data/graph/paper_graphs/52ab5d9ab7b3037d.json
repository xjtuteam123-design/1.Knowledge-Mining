  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "heteroepitaxial recrystallization (HeRX)",
      "category": "recrystallization",
      "sample_id": "sample_1",
      "material_state": "as-deformed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "1",
          "section": "Abstract",
          "quote": "Heteroepitaxial recrystallization (HeRX) is a recently discovered recrystallization mechanism that can occur during thermomechanical processing of Ni-base superalloys.",
          "table": null,
          "figure": null,
          "chunk_id": "52ab5d9ab7b3037d:part:001"
        },
        {
          "page": "12",
          "section": null,
          "quote": "HeRX is unique because it avoids the recovery-limited nucleation challenges of conventional recrystallization by allowing the preexisting primary γ′ particle to serve as a recrystallization nucleus.",
          "table": null,
          "figure": null,
          "chunk_id": "52ab5d9ab7b3037d:part:002"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "inverse precipitation",
      "category": "phase transformation",
      "sample_id": "sample_1",
      "material_state": "as-heat-treated",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "2",
          "section": "Introduction",
          "quote": "Because of the prior heat treatment, recrystallization was preceded by inverse precipitation in which a thin, coherent γ-like shell formed around the primary γ′ particles",
          "table": null,
          "figure": null,
          "chunk_id": "52ab5d9ab7b3037d:part:001"
        },
        {
          "page": "12",
          "section": null,
          "quote": "Half of the specimens used in this work were subjected to a preliminary heat treatment intended to induce inverse precipitation.",
          "table": null,
          "figure": null,
          "chunk_id": "52ab5d9ab7b3037d:part:002"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "discontinuous dynamic recrystallization (DDRX)",
      "category": "recrystallization",
