        "location": null,
        "composition": "Al-38.0Ti-6.7Ni-9.4Cu (at.%)",
        "identification_status": "experimental"
      },
      "evidence": [
        {
          "page": "2",
          "section": "3.1",
          "quote": "Phase B incorporating 38.0% Al, 38.6% Ti, 6.7% Ni and 9.4% Cu (at. %). The composition of the Al3NiTi2 phase with MgZn2-type structure ranges from Al30Ni28Ti42 (at. %) to Al50Ni16Ti34 (at. %) according to the Al–Ni–Ti ternary phase diagram [19–21]. Cu and Ni have similar atomic radii, crystal structure, electronegativities and infinite solubility [14,22,23]. Therefore, phase B was determined to be Al3(Ni, Cu)Ti2.",
          "table": "Table 2",
          "figure": "Fig. 3",
          "chunk_id": "adfa7cd5cbd3011c:part:001"
