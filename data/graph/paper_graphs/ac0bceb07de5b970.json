  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "Peierls stress reduction by decreased electron bonding directionality",
      "category": "intrinsic",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
          "page": "12",
          "section": "CONTROLLING MECHANISM",
          "quote": "alloying Mo with elements having a greater number of s+d electrons can lead to a reduction in the Peierls stress as a result of reducing the directionality of the electron bonding.",
          "table": null,
          "figure": null,
          "chunk_id": "ac0bceb07de5b970:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "interstitial scavenging",
      "category": "extrinsic",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "8",
          "section": "Scavenging",
          "quote": "interstitial scavenging, i. e. , chemical combination of solute and interstitial, is not responsible for alloy softening in the binary Mo alloys under investigation.",
          "table": null,
          "figure": null,
          "chunk_id": "ac0bceb07de5b970:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "atomic size misfit",
      "category": "extrinsic",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "12",
          "section": "CONTROLLING MECHANISM",
          "quote": "failure to correlate hardening or softening rates with atomic size factor alone, especially where the greatest rates of hardening and softening were observed in Mo-Pt alloys without a change in lattice parameter, precludes the atomic size factor being a controlling mechanism.",
          "table": null,
          "figure": null,
          "chunk_id": "ac0bceb07de5b970:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "electron concentration effect",
      "category": "intrinsic",
      "sample_id": null,
      "material_state": null,
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "11",
          "section": "DISCUSSION OF RESULTS",
          "quote": "the hardness or strength of binary alloys of Mo with sixth period elements Hf through Pt can best be correlated with electron concentration.",
          "table": null,
          "figure": null,
          "chunk_id": "ac0bceb07de5b970:part:001"
        }
      ]
    }
