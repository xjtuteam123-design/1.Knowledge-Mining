      ]
    },
    {
      "id": "mechanism_2",
      "name": "diffusion of alloying elements driven by lattice parameter difference",
      "category": "diffusion",
      "sample_id": "sample_1",
      "material_state": "modeled, negative misfit, tensile along [001]",
      "assertion_level": "author_hypothesis",
      "evidence": [
        {
