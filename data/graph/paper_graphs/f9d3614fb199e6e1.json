  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "phase dissolution",
      "category": "microstructural evolution",
      "sample_id": "sample_1",
      "material_state": "annealed at 800°C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "Discussion",
          "quote": "When the annealing temperature is increased from 800 to 1000°C, the Zr-enriched phase is partially dissolved (Fig. 2c2, d2) and element segregation is weakened (inset tables in Fig. 2c1, d1). The enhanced microstructural homogeneity and thus more diverse atoms in lattices promote lattice distortion in the dual-phase TiZrNbTa HEAs (Fig. 3).",
          "table": null,
          "figure": "Fig. 2c2, d2",
          "chunk_id": "f9d3614fb199e6e1:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "lattice distortion",
      "category": "strengthening mechanism",
      "sample_id": "sample_3",
      "material_state": "annealed at 1250°C",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "Discussion",
