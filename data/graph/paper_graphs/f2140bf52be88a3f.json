          "quote": "The dislocation pile-up at the FCC/B2 interface balances the strength and ductility in a wide temperature range.",
          "table": null,
          "figure": null,
          "chunk_id": "f2140bf52be88a3f:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "hetero-deformation-induced (HDI) strengthening",
      "category": "strengthening",
