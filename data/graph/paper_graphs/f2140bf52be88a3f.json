          "chunk_id": "f2140bf52be88a3f:part:001"
        }
      ]
    },
    {
      "id": "mechanism_3",
      "name": "dynamic recovery",
      "category": "softening",
      "sample_id": "sample_1",
      "material_state": "homogenized",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3. Results and discussion",
          "quote": "In general, dynamic recovery occurs when deforming at elevated temperature.",
          "table": null,
          "figure": null,
          "chunk_id": "f2140bf52be88a3f:part:001"
        }
      ]
    },
    {
      "id": "mechanism_4",
      "name": "strain partitioning",
      "category": "deformation",
      "sample_id": "sample_1",
      "material_state": "homogenized",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 4,
          "section": "3. Results and discussion",
          "quote": "During deformation, the softer FCC phase can accommodate more strain produced than the B2 phase, which is called strain partitioning.",
