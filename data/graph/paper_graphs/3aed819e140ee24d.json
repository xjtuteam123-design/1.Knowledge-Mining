  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "interlamellar slip band decohesion",
      "category": "fatigue crack initiation",
      "sample_id": "sample_1",
      "material_state": "fatigue tested",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": "7",
          "section": "4.1. Fatigue crack initiation",
          "quote": "The interlamellar slip intensiﬁed upon further fatigue cycling, but the transmission of slip into contiguous grains did not always occur. As a result, some grains were heavily deformed while others did not appear to exhibit any slip and then fatigue crack could be formed by decohesion of an interlamellar slip band [27].",
          "table": null,
          "figure": null,
          "chunk_id": "3aed819e140ee24d:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "dislocation pile-up at alpha2/gamma interface",
      "category": "fatigue crack initiation",
      "sample_id": "sample_1",
      "material_state": "fatigue tested",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
