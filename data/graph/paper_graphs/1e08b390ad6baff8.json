      "id": "alloy_system_1",
      "name": "Ti-Zr-Mo alloy (TZM)",
      "material_category": "molybdenum-base alloy",
      "evidence": [
        {
          "page": "1",
          "section": "Introduction",
          "quote": "Titanium zirconium molybdenum (TZM) is a molybdenum-base alloy engineered for high strength at high temperatures. It exhibits a low thermal expansion coefficient, high thermal and electrical conductivity and excellent thermal shock resistance [1–5]. TZM B387 type 364 nominally contains 0.4–0.55 wt% titanium (Ti), 0.06–0.12 wt% zirconium (Zr), 0.01–0.04 wt% carbon (C), and balance molybdenum (Mo) [6].",
          "table": null,
          "figure": null,
          "chunk_id": "1e08b390ad6baff8:part:001"
        }
      ]
    }
  ],
