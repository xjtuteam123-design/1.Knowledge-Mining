  "mechanisms": [
    {
      "id": "mechanism_1",
      "name": "dislocation source activation at interface",
      "category": "dislocation plasticity",
      "sample_id": "sample_2",
      "material_state": "rotary-swaged and annealed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 5,
          "section": "Results",
          "quote": "The aforementioned findings provide an approach to overcoming the strength-ductility trade-off in Mo alloy. The achievement originated from the diverse changes in the electronic density of states of rare-earth elements, which enables the formation of a “bumpy” and amorphous oxides-matrix interface under proper control of materials processing. This interface helps to divide one dislocation into many segments, creating dislocation sources pinned at the interface during dislocation-particle interactions.",
          "table": null,
          "figure": null,
          "chunk_id": "c499312185d74a25:part:001"
        }
      ]
    },
    {
      "id": "mechanism_2",
      "name": "vacancy absorption and dislocation configuration modification",
      "category": "defect interaction",
      "sample_id": "sample_2",
      "material_state": "rotary-swaged and annealed",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 2,
          "section": "Results",
          "quote": "we first ascertained that precise control of the interfacial reaction during even conventional liquid-solid mixing effectively facilitates the formation of an ultrathin amorphous interfacial layer between La2O3 particles and the Mo matrix, which exhibits a propensity for vacancy absorption and modification of dislocation configurations.",
          "table": null,
          "figure": null,
          "chunk_id": "c499312185d74a25:part:001"
        }
      ]
    }
  ],
