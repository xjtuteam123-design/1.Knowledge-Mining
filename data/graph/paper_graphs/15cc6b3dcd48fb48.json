    },
    {
      "id": "mechanism_2",
      "name": "Mo site occupancy preference governed by atomic size and electronegativity",
      "category": "site occupation",
      "sample_id": "sample_2",
      "material_state": "aged",
      "assertion_level": "author_interpretation",
      "evidence": [
        {
          "page": 1,
          "section": "abstract",
          "quote": "It was found that Mo atoms with larger size and smaller electronegativity tend to occupy 6c3, 6c1 and 6c2 sites in order of priority. Ni atoms mainly occupy the sites with coordination number (CN) of 12 at 3a and 18 h, and 3a sites contain more Cr atoms than 18 h sites.",
          "table": null,
          "figure": null,
          "chunk_id": "15cc6b3dcd48fb48:part:001"
        }
      ]
    }
